-- ══════════════════════════════════════════════════════
--  UTILITIES
-- ══════════════════════════════════════════════════════
local function isAlive(p)
    return p and p.Character
        and p.Character:FindFirstChild("HumanoidRootPart")
        and p.Character:FindFirstChild("Humanoid")
        and p.Character.Humanoid.Health > 0
end

local function getEnemies()
    -- *just geometry with a pulse*
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and isAlive(p) then
            table.insert(out, p)
        end
    end
    return out
end

local function getClosest(fov)
    -- Returns player whose target part is closest to screen centre
    -- within fov radius (pixels). nil if nobody qualifies.
    local best, bestDist = nil, math.huge
    local cx = Camera.ViewportSize.X * 0.5
    local cy = Camera.ViewportSize.Y * 0.5
    for _, p in ipairs(getEnemies()) do
        local part = p.Character:FindFirstChild(CFG.SilentAim.TargetPart)
                  or p.Character:FindFirstChild("HumanoidRootPart")
        if part then
            local sp, vis = Camera:WorldToViewportPoint(part.Position)
            if vis then
                local d = math.sqrt((sp.X-cx)^2 + (sp.Y-cy)^2)
                if d < (fov or math.huge) and d < bestDist then
                    bestDist = d
                    best = p
                end
            end
        end
    end
    return best
end

local function roll(pct)
    return math.random(1, 100) <= pct
end

-- ══════════════════════════════════════════════════════
--  SILENT AIM  — __namecall hook on Mouse
--  Intercepts Mouse:Hit so server-side raycasts land on head
--  *this is not aiming, this is forgery at the speed of light*
-- ══════════════════════════════════════════════════════
local mt      = getrawmetatable(game)
local oldNC   = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    -- Intercept Mouse:Hit (property via namecall) and
    -- Mouse:ViewSizeX/Y calls used by tool raycasts
    if CFG.SilentAim.Enabled then
        if method == "Hit" or method == "UnitRay" then
            if roll(CFG.SilentAim.HitChance) then
                local target = getClosest(CFG.Aimbot.FOV)
                if target then
                    local part = target.Character:FindFirstChild(CFG.SilentAim.TargetPart)
                             or target.Character:FindFirstChild("HumanoidRootPart")
                    if part then
                        -- return a spoofed CFrame/Ray pointing at the target part
                        if method == "Hit" then
                            return CFrame.new(part.Position)
                        elseif method == "UnitRay" then
                            local origin = Camera.CFrame.Position
                            local dir    = (part.Position - origin).Unit
                            return Ray.new(origin, dir * 1000)
                        end
                    end
                end
            end
        end
    end
    return oldNC(self, ...)
end)

setreadonly(mt, true)

-- ══════════════════════════════════════════════════════
--  AIMBOT  — lerps Camera.CFrame each Heartbeat
--  Smoothing 0 = instant lock; higher = butter slide
--  *camera doesn't look — it arrives*
-- ══════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    if not CFG.Aimbot.Enabled then return end
    local target = getClosest(CFG.Aimbot.FOV)
    if not target then return end
    local part = target.Character:FindFirstChild(CFG.Aimbot.TargetPart)
              or target.Character:FindFirstChild("HumanoidRootPart")
    if not part then return end

    local origin  = Camera.CFrame.Position
    local dir     = (part.Position - origin).Unit
    local goal    = CFrame.new(origin, origin + dir)
    local smooth  = math.clamp(CFG.Aimbot.Smoothing, 0, 20)

    if smooth == 0 then
        Camera.CFrame = goal
    else
        Camera.CFrame = Camera.CFrame:Lerp(goal, 1 / (smooth + 1))
    end
end)

-- ══════════════════════════════════════════════════════
--  ORBIT  — rotates local root around closest enemy
--  Radius 0-25 studs, Height 0-100 mapped to stud offset
--  Clears dead target automatically
--  *the moon doesn't orbit the earth — it just never misses*
-- ══════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function(dt)
    if not CFG.Orbit.Enabled then return end
    if not lpRoot then return end

    -- refresh target if dead or gone
    local t = CFG.Orbit._target
    if not isAlive(t) then
        t = getClosest()
        CFG.Orbit._target = t
    end
    if not t then return end

    local root = t.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    CFG.Orbit._angle = (CFG.Orbit._angle + dt * CFG.Orbit.Speed * 2) % (math.pi * 2)
    local r  = CFG.Orbit.Radius
    local h  = CFG.Orbit.Height * 0.1   -- 100 height units = 10 studs above target
    local ox = math.cos(CFG.Orbit._angle) * r
    local oz = math.sin(CFG.Orbit._angle) * r
    local newPos = root.Position + Vector3.new(ox, h, oz)
    -- face the target while orbiting
    lpRoot.CFrame = CFrame.new(newPos, root.Position)
end)

-- ══════════════════════════════════════════════════════
--  RAPID FIRE  — kills animation lock between shots
--  Finds equipped tool, stops all animator tracks at 0 fade,
--  then fires the tool's shoot RemoteEvent directly
--  Uses a Connection pattern instead of while loop
--  to prevent ghost loops on retoggle
--  *the gun forgot it had feelings about recoil*
-- ══════════════════════════════════════════════════════
local rfConn = nil

local function stopRapidFire()
    if rfConn then rfConn:Disconnect(); rfConn = nil end
end

local function startRapidFire()
    stopRapidFire()
    rfConn = RunService.Heartbeat:Connect(function()
        if not CFG.RapidFire.Enabled then stopRapidFire(); return end
        if not lpChar then return end
        local tool = lpChar:FindFirstChildOfClass("Tool")
        if not tool then return end

        -- kill animation lock
        local hum = lpChar:FindFirstChildOfClass("Humanoid")
        if hum then
            local anim = hum:FindFirstChildOfClass("Animator")
            if anim then
                for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
                    tr:Stop(0)
                end
            end
        end

        -- fire: prefer RemoteEvent named Fire/Shoot, else search all RemoteEvents
        local re = tool:FindFirstChild("Fire")
                or tool:FindFirstChild("Shoot")
                or tool:FindFirstChild("ShootEvent")
                or tool:FindFirstChildOfClass("RemoteEvent")
        if re and re:IsA("RemoteEvent") then
            re:FireServer()
        end
    end)
end

-- ══════════════════════════════════════════════════════
--  RAPID MELEE  — same pattern, filters melee anims
--  Stops swing/attack tracks by name keyword
--  *the knife stopped asking permission to land*
-- ══════════════════════════════════════════════════════
local rmConn = nil

local function stopRapidMelee()
    if rmConn then rmConn:Disconnect(); rmConn = nil end
end

local function startRapidMelee()
    stopRapidMelee()
    rmConn = RunService.Heartbeat:Connect(function()
        if not CFG.RapidMelee.Enabled then stopRapidMelee(); return end
        if not lpChar then return end
        local tool = lpChar:FindFirstChildOfClass("Tool")
        if not tool then return end

        local hum = lpChar:FindFirstChildOfClass("Humanoid")
        if hum then
            local anim = hum:FindFirstChildOfClass("Animator")
            if anim then
                for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
                    local id = tr.Animation and tr.Animation.AnimationId or ""
                    -- stop any track that looks like a swing/melee/attack
                    if id:lower():find("melee") or id:lower():find("swing")
                    or id:lower():find("attack") or id:lower():find("slash") then
                        tr:Stop(0)
                    end
                end
            end
        end

        local re = tool:FindFirstChild("Hit")
                or tool:FindFirstChild("Melee")
                or tool:FindFirstChild("MeleeEvent")
                or tool:FindFirstChildOfClass("RemoteEvent")
        if re and re:IsA("RemoteEvent") then
            re:FireServer()
        end
    end)
end

-- ══════════════════════════════════════════════════════
--  RAGEBOT / VOID SPAM
--  Peek cycle: hide HideTime sec → step out AttackTime sec → repeat
--  Void spam: probe for missing floor in 8 directions,
--             fling target AssemblyLinearVelocity toward void edge
--  Single loop guard — no duplicate spawns
--  *peek, fire, gone. the killcam shows a ghost.*
-- ══════════════════════════════════════════════════════
local rageActive  = false
local rageSafePos = nil

local function findVoidDir()
    if not lpRoot then return nil end
    local pos = lpRoot.Position
    local rp  = RaycastParams.new()
    rp.FilterDescendantsInstances = {lpChar}
    rp.FilterType = Enum.RaycastFilterType.Exclude

    -- probe 8 directions at 150-stud radius
    for angle = 0, 2*math.pi - 0.01, math.pi/4 do
        local probe = pos + Vector3.new(math.cos(angle)*150, 0, math.sin(angle)*150)
        local ray   = workspace:Raycast(probe + Vector3.new(0,10,0), Vector3.new(0,-300,0), rp)
        if not ray then
            return (probe - pos).Unit  -- direction toward void
        end
    end
    return nil
end

local function rageBotLoop()
    if rageActive then return end  -- guard: no duplicate loops
    rageActive = true
    rageSafePos = lpRoot and lpRoot.CFrame or nil

    while CFG.Ragebot.Enabled do
        -- HIDE phase: snap back to safe position
        if lpRoot and rageSafePos then
            lpRoot.CFrame = rageSafePos
        end
        task.wait(math.clamp(CFG.Ragebot.HideTime, 1, 5))

        if not CFG.Ragebot.Enabled then break end

        -- ATTACK phase
        if CFG.Ragebot.VoidSpam then
            local target = getClosest()
            if target and isAlive(target) then
                local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                local voidDir = findVoidDir()
                if tRoot and voidDir then
                    -- step close to target
                    if lpRoot then
                        lpRoot.CFrame = CFrame.new(tRoot.Position + Vector3.new(0,0,2))
                    end
                    -- fling target toward void at high velocity
                    tRoot.AssemblyLinearVelocity = voidDir * 350
                end
            end
        else
            -- basic peek: step sideways from safe position
            if lpRoot and rageSafePos then
                lpRoot.CFrame = rageSafePos * CFrame.new(5, 0, 0)
            end
        end

        task.wait(math.clamp(CFG.Ragebot.AttackTime, 1, 5))
    end

    rageActive = false
end

