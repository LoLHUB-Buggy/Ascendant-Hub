    lbl.Position           = UDim2.new(0, 24, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text               = label
    lbl.TextColor3         = THEME.TEXT
    lbl.Font               = Enum.Font.Gotham
    lbl.TextSize           = 11
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.ZIndex             = 5

    local state = default
    local btn = Instance.new("TextButton", row)
    btn.Size               = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text               = ""
    btn.ZIndex             = 6
    btn.MouseButton1Click:Connect(function()
        state = not state
        box.BackgroundColor3 = state and THEME.CHECKBOX_ON or THEME.TOGGLE_OFF
        callback(state)
    end)
    return row
end

-- Slider — fixed: reads AbsolutePosition only during live input (after layout resolves)
local function makeSlider(page, label, minV, maxV, default, fmt, callback)
    -- fmt: "integer" or "decimal"
    local container = Instance.new("Frame")
    container.Size             = UDim2.new(1, 0, 0, 40)
    container.BackgroundColor3 = THEME.PANEL
    container.BorderSizePixel  = 0
    container.LayoutOrder      = nextLO(page)
    container.ZIndex           = 4
    container.Parent           = page
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 3)

    local lblEl = Instance.new("TextLabel", container)
    lblEl.Size               = UDim2.new(0.65, 0, 0, 16)
    lblEl.Position           = UDim2.new(0, 8, 0, 3)
    lblEl.BackgroundTransparency = 1
    lblEl.Text               = label
    lblEl.TextColor3         = THEME.TEXTDIM
    lblEl.Font               = Enum.Font.Gotham
    lblEl.TextSize           = 10
    lblEl.TextXAlignment     = Enum.TextXAlignment.Left
    lblEl.ZIndex             = 5

    local valEl = Instance.new("TextLabel", container)
    valEl.Size               = UDim2.new(0.3, 0, 0, 16)
    valEl.Position           = UDim2.new(0.7, -8, 0, 3)
    valEl.BackgroundTransparency = 1
    valEl.Text               = tostring(default)
    valEl.TextColor3         = THEME.ACCENT
    valEl.Font               = Enum.Font.GothamBold
    valEl.TextSize           = 10
    valEl.TextXAlignment     = Enum.TextXAlignment.Right
    valEl.ZIndex             = 5

    local track = Instance.new("Frame", container)
    track.Size             = UDim2.new(1, -16, 0, 5)
    track.Position         = UDim2.new(0, 8, 0, 26)
    track.BackgroundColor3 = THEME.SLIDER_BG
    track.BorderSizePixel  = 0
    track.ZIndex           = 5
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local initRatio = math.clamp((default - minV) / (maxV - minV), 0, 1)
    local fill = Instance.new("Frame", track)
    fill.Size             = UDim2.new(initRatio, 0, 1, 0)
    fill.BackgroundColor3 = THEME.SLIDER_FILL
    fill.BorderSizePixel  = 0
    fill.ZIndex           = 6
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local sliding = false
    local value   = default

    local function applyPos(mouseX)
        -- safe: AbsolutePosition only read when sliding = true (layout has resolved)
        local ax   = track.AbsolutePosition.X
        local aw   = track.AbsoluteSize.X
        if aw == 0 then return end
        local rel  = math.clamp((mouseX - ax) / aw, 0, 1)
        if fmt == "decimal" then
            value = math.floor((minV + (maxV - minV) * rel) * 10 + 0.5) / 10
            valEl.Text = string.format("%.1f", value)
        else
            value = math.floor(minV + (maxV - minV) * rel + 0.5)
            valEl.Text = tostring(value)
        end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        callback(value)
    end

    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            applyPos(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
            applyPos(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)
    return container
end

local function makeInfoRow(page, text)
    local f = Instance.new("Frame")
    f.Size             = UDim2.new(1, 0, 0, 20)
    f.BackgroundColor3 = THEME.PANEL
    f.BorderSizePixel  = 0
    f.LayoutOrder      = nextLO(page)
    f.ZIndex           = 4
    f.Parent           = page
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 3)
    local l = Instance.new("TextLabel", f)
    l.Size               = UDim2.new(1, -10, 1, 0)
    l.Position           = UDim2.new(0, 8, 0, 0)
    l.BackgroundTransparency = 1
    l.Text               = text
    l.TextColor3         = THEME.TEXTDIM
    l.Font               = Enum.Font.Gotham
    l.TextSize           = 10
    l.TextXAlignment     = Enum.TextXAlignment.Left
    l.ZIndex             = 5
    return f
end

