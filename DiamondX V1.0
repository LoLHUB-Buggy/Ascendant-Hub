-- DiamondX Hub | V1.1 | Mobile-first rewrite
-- Tabs: Main, ESP, Visual, Character, Misc, UI Settings
-- Touch-native: drag, sliders, oversized tap targets, scale-relative sizing

local CoreGui          = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local RunService       = game:GetService("RunService")
local Players          = game:GetService("Players")
local Stats            = game:GetService("Stats")          -- fetched properly
local LocalPlayer      = Players.LocalPlayer

-- ─────────────────────────────────────────────
--  SCREEN METRICS  (mobile-relative)
-- ─────────────────────────────────────────────
local VP          = workspace.CurrentCamera.ViewportSize
local IS_MOBILE   = UserInputService.TouchEnabled
local WIN_W       = math.min(VP.X - 20, IS_MOBILE and 420 or 700)
local WIN_H       = IS_MOBILE and 340 or 420
local SIDEBAR_W   = IS_MOBILE and 80  or 90
local TAP_H       = IS_MOBILE and 36  or 22   -- finger-friendly row height
local CHECK_SZ    = IS_MOBILE and 22  or 14   -- checkbox square
local FONT_SZ_LG  = IS_MOBILE and 15  or 13
local FONT_SZ_SM  = IS_MOBILE and 13  or 11
local TAB_FONT    = IS_MOBILE and 13  or 12

-- ─────────────────────────────────────────────
--  CONFIG
-- ─────────────────────────────────────────────
local Config = {
    RagebotEnabled = false,
    Orbit          = false,
    Desync         = false,
    AttackTick     = 1,
    HideTick       = 1,
    Wallbang       = false,
    ESPEnabled     = false,
    ESPBoxes       = false,
    ESPNames       = false,
    ESPHealth      = false,
    ESPTracers     = false,
    NoRecoil       = false,
    NoSpread       = false,
    FullBright     = false,
    Fly            = false,
    FlySpeed       = 50,
    InfiniteJump   = false,
    Noclip         = false,
    SpeedHack      = false,
    WalkSpeed      = 16,
    RapidFire      = false,
    FastAttack     = false,
    AutoParry      = false,
    UILocked       = false,
    UIHidden       = false,
}

-- ─────────────────────────────────────────────
--  CLEANUP
-- ─────────────────────────────────────────────
if CoreGui:FindFirstChild("DiamondXHub") then
    CoreGui.DiamondXHub:Destroy()
end

-- ─────────────────────────────────────────────
--  ROOT GUI
-- ─────────────────────────────────────────────
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name             = "DiamondXHub"
ScreenGui.Parent           = CoreGui
ScreenGui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
ScreenGui.ResetOnSpawn     = false
ScreenGui.IgnoreGuiInset   = true   -- fixes notch/status-bar offset on phones

-- ─────────────────────────────────────────────
--  COLOURS
-- ─────────────────────────────────────────────
local C = {
    bg         = Color3.fromRGB(13,  15,  30),
    panel      = Color3.fromRGB(18,  20,  40),
    border     = Color3.fromRGB(80,  60, 160),
    tabActive  = Color3.fromRGB(22,  24,  48),
    tabInactive= Color3.fromRGB(13,  15,  30),
    groupBg    = Color3.fromRGB(16,  18,  36),
    sliderFill = Color3.fromRGB(90,  60, 180),
    sliderBg   = Color3.fromRGB(28,  22,  55),
    checkOn    = Color3.fromRGB(90,  60, 180),
    checkOff   = Color3.fromRGB(28,  22,  55),
    textMain   = Color3.fromRGB(220, 215, 240),
    textDim    = Color3.fromRGB(150, 140, 175),
    textHeader = Color3.fromRGB(255, 255, 255),
    sidebarBg  = Color3.fromRGB(10,  12,  26),
    topbar     = Color3.fromRGB(10,  12,  26),
    red        = Color3.fromRGB(180,  40,  40),
}

-- ─────────────────────────────────────────────
--  SIDEBAR  (draggable on mobile)
-- ─────────────────────────────────────────────
local Sidebar = Instance.new("Frame", ScreenGui)
Sidebar.Name             = "Sidebar"
Sidebar.BackgroundColor3 = C.sidebarBg
Sidebar.BorderColor3     = C.border
Sidebar.BorderSizePixel  = 1
Sidebar.Position         = UDim2.new(0, 0, 0.30, 0)
Sidebar.Size             = UDim2.new(0, SIDEBAR_W, 0, TAP_H * 2 + 2)
Sidebar.ZIndex           = 20
Sidebar.Active           = true

-- sidebar drag
local sDrag, sDragStart, sSideStart
Sidebar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        sDrag = true; sDragStart = i.Position; sSideStart = Sidebar.Position
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then sDrag = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if not sDrag then return end
    if i.UserInputType ~= Enum.UserInputType.MouseMovement
    and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = i.Position - sDragStart
    Sidebar.Position = UDim2.new(
        sSideStart.X.Scale, sSideStart.X.Offset + d.X,
        sSideStart.Y.Scale, sSideStart.Y.Offset + d.Y
    )
end)

local function makeSideBtn(text, yOff)
    local b = Instance.new("TextButton", Sidebar)
    b.BackgroundColor3 = C.sidebarBg
    b.BorderColor3     = C.border
    b.BorderSizePixel  = 1
    b.Position         = UDim2.new(0, 0, 0, yOff)
    b.Size             = UDim2.new(1, 0, 0, TAP_H)
    b.Font             = Enum.Font.SourceSansBold
    b.Text             = text
    b.TextColor3       = C.textMain
    b.TextSize         = FONT_SZ_SM
    b.ZIndex           = 21
    return b
end

local ToggleBtn = makeSideBtn("Toggle UI", 0)
local UnlockBtn = makeSideBtn("Unlock UI", TAP_H + 2)

-- ─────────────────────────────────────────────
--  MAIN WINDOW  (scale-relative, centered)
-- ─────────────────────────────────────────────
local Win = Instance.new("Frame", ScreenGui)
Win.Name             = "MainWindow"
Win.BackgroundColor3 = C.bg
Win.BorderColor3     = C.border
Win.BorderSizePixel  = 2
Win.Position         = UDim2.new(0.5, -WIN_W/2, 0.5, -WIN_H/2)
Win.Size             = UDim2.new(0, WIN_W, 0, WIN_H)
Win.Active           = true
Win.ZIndex           = 5

-- window drag  (touch + mouse, unified)
local wDrag, wDragStart, wWinStart, wLastInput
Win.InputBegan:Connect(function(i)
    if Config.UILocked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        wDrag = true; wDragStart = i.Position; wWinStart = Win.Position
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then wDrag = false end
        end)
    end
end)
Win.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseMovement
    or i.UserInputType == Enum.UserInputType.Touch then
        wLastInput = i
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if Config.UILocked or not wDrag or i ~= wLastInput then return end
    local d = i.Position - wDragStart
    Win.Position = UDim2.new(
        wWinStart.X.Scale, wWinStart.X.Offset + d.X,
        wWinStart.Y.Scale, wWinStart.Y.Offset + d.Y
    )
end)

-- ─────────────────────────────────────────────
--  TOP BAR
-- ─────────────────────────────────────────────
local TOPBAR_H = IS_MOBILE and 36 or 28

local TopBar = Instance.new("Frame", Win)
TopBar.BackgroundColor3 = C.topbar
TopBar.BorderColor3     = C.border
TopBar.BorderSizePixel  = 1
TopBar.Size             = UDim2.new(1, 0, 0, TOPBAR_H)
TopBar.ZIndex           = 6

local TopStats = Instance.new("TextLabel", TopBar)
TopStats.BackgroundTransparency = 1
TopStats.Position        = UDim2.new(0, 8, 0, 0)
TopStats.Size            = UDim2.new(1, -36, 1, 0)
TopStats.Font            = Enum.Font.SourceSansBold
TopStats.TextColor3      = C.textMain
TopStats.TextSize        = FONT_SZ_SM
TopStats.TextXAlignment  = Enum.TextXAlignment.Left
TopStats.ZIndex          = 7
TopStats.Text            = "DiamondX | V1.1 | Free | -- fps | -- ms"

-- fps/ping  — fixed: no nested :Wait() inside RenderStepped
local fpsBuffer, fpsClock, fpsValue, pingValue = {}, 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
    fpsClock = fpsClock + dt
    table.insert(fpsBuffer, dt)
    if fpsClock >= 0.5 then
        local total = 0
        for _, v in ipairs(fpsBuffer) do total = total + v end
        fpsValue  = math.floor(#fpsBuffer / total + 0.5)
        fpsBuffer = {}
        fpsClock  = 0
        pcall(function()
            pingValue = math.floor(
                Stats.Network.ServerStatsItem["Data Ping"].Value
            )
        end)
        TopStats.Text = string.format(
            "DiamondX | V1.1 | Free | %d fps | %d ms", fpsValue, pingValue
        )
    end
end)

-- close X  (bigger touch target on mobile)
local CLOSE_SZ = IS_MOBILE and 28 or 18
local CloseX = Instance.new("TextButton", TopBar)
CloseX.BackgroundColor3 = C.red
CloseX.BorderSizePixel  = 0
CloseX.Position  = UDim2.new(1, -(CLOSE_SZ + 4), 0, (TOPBAR_H - CLOSE_SZ) / 2)
CloseX.Size      = UDim2.new(0, CLOSE_SZ, 0, CLOSE_SZ)
CloseX.Font      = Enum.Font.SourceSansBold
CloseX.Text      = "X"
CloseX.TextColor3 = Color3.new(1,1,1)
CloseX.TextSize  = IS_MOBILE and 14 or 11
CloseX.ZIndex    = 8
CloseX.MouseButton1Click:Connect(function()
    Win.Visible    = false
    ToggleBtn.Text = "Open UI"
end)

-- ─────────────────────────────────────────────
--  TAB BAR
-- ─────────────────────────────────────────────
local TAB_BAR_H   = IS_MOBILE and 32 or 28
local TAB_Y       = TOPBAR_H + 2
local CONTENT_Y   = TAB_Y + TAB_BAR_H + 2
local CONTENT_H   = WIN_H - CONTENT_Y - 4

local TabBar = Instance.new("Frame", Win)
TabBar.BackgroundTransparency = 1
TabBar.Position = UDim2.new(0, 4, 0, TAB_Y)
TabBar.Size     = UDim2.new(1, -8, 0, TAB_BAR_H)
TabBar.ZIndex   = 6

local tabNames = {"Main","ESP","Visual","Character","Misc","UI Settings"}
local tabPages  = {}
local tabBtns   = {}
local TAB_W     = 1 / #tabNames

for i, name in ipairs(tabNames) do
    local tb = Instance.new("TextButton", TabBar)
    tb.BackgroundColor3 = (i==1) and C.tabActive or C.tabInactive
    tb.BorderColor3     = C.border
    tb.BorderSizePixel  = 1
    tb.Position  = UDim2.new((i-1)*TAB_W, 1, 0, 0)
    tb.Size      = UDim2.new(TAB_W, -2, 1, 0)
    tb.Font      = Enum.Font.SourceSansBold
    tb.Text      = name
    tb.TextColor3 = C.textMain
    tb.TextSize  = TAB_FONT
    tb.ZIndex    = 7
    -- truncate long tab names on narrow screens
    tb.TextTruncate = Enum.TextTruncate.AtEnd
    tabBtns[name] = tb

    local pg = Instance.new("ScrollingFrame", Win)
    pg.Name                = name.."Page"
    pg.BackgroundColor3    = C.panel
    pg.BorderColor3        = C.border
    pg.BorderSizePixel     = 1
    pg.Position            = UDim2.new(0, 4, 0, CONTENT_Y)
    pg.Size                = UDim2.new(1, -8, 0, CONTENT_H)
    pg.CanvasSize          = UDim2.new(0, 0, 0, 600)
    pg.ScrollBarThickness  = IS_MOBILE and 6 or 4
    pg.ScrollBarImageColor3= C.sliderFill
    pg.ScrollingDirection  = Enum.ScrollingDirection.Y
    pg.Visible             = (i==1)
    pg.ZIndex              = 6
    tabPages[name] = pg

    tb.MouseButton1Click:Connect(function()
        for n,p in pairs(tabPages) do p.Visible = (n==name) end
        for n,b in pairs(tabBtns)  do
            b.BackgroundColor3 = (n==name) and C.tabActive or C.tabInactive
        end
    end)
end

-- ─────────────────────────────────────────────
--  WIDGET HELPERS
-- ─────────────────────────────────────────────

local GBW = WIN_W - 24   -- group box width fills page minus padding

local function GroupBox(parent, title, h, x, y)
    local f = Instance.new("Frame", parent)
    f.BackgroundColor3 = C.groupBg
    f.BorderColor3     = C.border
    f.BorderSizePixel  = 1
    f.Position = UDim2.new(0, x, 0, y)
    f.Size     = UDim2.new(0, GBW, 0, h)
    f.ZIndex   = 7

    local lbl = Instance.new("TextLabel", f)
    lbl.BackgroundTransparency = 1
    lbl.Position  = UDim2.new(0, 10, 0, 4)
    lbl.Size      = UDim2.new(1, -14, 0, 20)
    lbl.Font      = Enum.Font.SourceSansBold
    lbl.Text      = title
    lbl.TextColor3 = C.textHeader
    lbl.TextSize  = FONT_SZ_LG
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex    = 8
    return f
end

-- Checkbox with oversized invisible touch hitbox
local function Checkbox(parent, label, configKey, y)
    -- invisible tap-zone (full row width, finger-friendly height)
    local hitbox = Instance.new("TextButton", parent)
    hitbox.BackgroundTransparency = 1
    hitbox.BorderSizePixel = 0
    hitbox.Position = UDim2.new(0, 0, 0, y - 4)
    hitbox.Size     = UDim2.new(1, 0, 0, TAP_H)
    hitbox.Text     = ""
    hitbox.ZIndex   = 10

    -- visible checkbox square
    local box = Instance.new("Frame", parent)
    box.BackgroundColor3 = Config[configKey] and C.checkOn or C.checkOff
    box.BorderColor3     = C.border
    box.BorderSizePixel  = 1
    box.Position = UDim2.new(0, 10, 0, y + (TAP_H - CHECK_SZ)/2 - 4)
    box.Size     = UDim2.new(0, CHECK_SZ, 0, CHECK_SZ)
    box.ZIndex   = 9

    local tick = Instance.new("TextLabel", box)
    tick.BackgroundTransparency = 1
    tick.Size      = UDim2.new(1,0,1,0)
    tick.Font      = Enum.Font.SourceSansBold
    tick.Text      = Config[configKey] and "✓" or ""
    tick.TextColor3 = Color3.new(1,1,1)
    tick.TextSize  = CHECK_SZ - 4
    tick.ZIndex    = 10

    local lbl = Instance.new("TextLabel", parent)
    lbl.BackgroundTransparency = 1
    lbl.Position  = UDim2.new(0, CHECK_SZ + 16, 0, y - 2)
    lbl.Size      = UDim2.new(1, -(CHECK_SZ + 20), 0, TAP_H)
    lbl.Font      = Enum.Font.SourceSans
    lbl.Text      = label
    lbl.TextColor3 = C.textMain
    lbl.TextSize  = FONT_SZ_LG
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex    = 9

    hitbox.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        box.BackgroundColor3 = Config[configKey] and C.checkOn or C.checkOff
        tick.Text = Config[configKey] and "✓" or ""
    end)
end

-- Slider  — full touch drag, fires on Touch AND MouseMovement
local SLIDER_W = GBW - 20

local function Slider(parent, label, configKey, minV, maxV, y)
    local rowH = TAP_H + 22

    local lbl = Instance.new("TextLabel", parent)
    lbl.BackgroundTransparency = 1
    lbl.Position  = UDim2.new(0, 10, 0, y)
    lbl.Size      = UDim2.new(0, SLIDER_W, 0, 18)
    lbl.Font      = Enum.Font.SourceSans
    lbl.Text      = label .. ": " .. tostring(Config[configKey])
    lbl.TextColor3 = C.textMain
    lbl.TextSize  = FONT_SZ_SM
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex    = 9

    local track = Instance.new("Frame", parent)
    track.BackgroundColor3 = C.sliderBg
    track.BorderColor3     = C.border
    track.BorderSizePixel  = 1
    track.Position = UDim2.new(0, 10, 0, y + 20)
    track.Size     = UDim2.new(0, SLIDER_W, 0, IS_MOBILE and 20 or 14)
    track.ZIndex   = 9

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = C.sliderFill
    fill.BorderSizePixel  = 0
    fill.Size    = UDim2.new((Config[configKey] - minV)/(maxV - minV), 0, 1, 0)
    fill.ZIndex  = 10

    -- thumb dot
    local thumb = Instance.new("Frame", track)
    thumb.BackgroundColor3 = Color3.new(1,1,1)
    thumb.BorderSizePixel  = 0
    thumb.AnchorPoint      = Vector2.new(0.5, 0.5)
    thumb.Size   = UDim2.new(0, IS_MOBILE and 16 or 10, 0, IS_MOBILE and 16 or 10)
    thumb.Position = UDim2.new((Config[configKey]-minV)/(maxV-minV), 0, 0.5, 0)
    thumb.ZIndex = 11
    local tc = Instance.new("UICorner", thumb); tc.CornerRadius = UDim.new(1,0)

    local sliding = false

    local function applyX(screenX)
        local absX   = track.AbsolutePosition.X
        local absW   = track.AbsoluteSize.X
        local rel    = math.clamp((screenX - absX) / absW, 0, 1)
        local val    = math.floor(rel * (maxV - minV) + minV + 0.5)
        Config[configKey] = val
        fill.Size     = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, 0, 0.5, 0)
        lbl.Text      = label .. ": " .. tostring(val)
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            applyX(i.Position.X)
        end
    end)
    track.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    -- global move so finger can leave the track frame and still drag
    UserInputService.InputChanged:Connect(function(i)
        if not sliding then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            applyX(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
end

-- ─────────────────────────────────────────────
--  ROW SPACING HELPER
-- ─────────────────────────────────────────────
local function cbY(index)  return 28 + (index-1) * (TAP_H + 4) end
local function slY(index)  return 28 + (index-1) * (TAP_H + 28) end

