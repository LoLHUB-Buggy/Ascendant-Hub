    border      = Color3.fromRGB(80,  60, 160),   -- purple border
    tabActive   = Color3.fromRGB(22,  24,  48),   -- active tab bg
    tabInactive = Color3.fromRGB(13,  15,  30),   -- inactive tab bg
    groupBg     = Color3.fromRGB(16,  18,  36),   -- group box fill
    sliderFill  = Color3.fromRGB(90,  60, 180),   -- purple slider
    sliderBg    = Color3.fromRGB(28,  22,  55),   -- slider track
    checkOn     = Color3.fromRGB(90,  60, 180),
    checkOff    = Color3.fromRGB(28,  22,  55),
    textMain    = Color3.fromRGB(220, 215, 240),
    textDim     = Color3.fromRGB(150, 140, 175),
    textHeader  = Color3.fromRGB(255, 255, 255),
    sidebarBg   = Color3.fromRGB(10,  12,  26),
    topbar      = Color3.fromRGB(10,  12,  26),
    red         = Color3.fromRGB(180,  40,  40),
}

-- ─────────────────────────────────────────────
--  SIDEBAR  (Toggle UI / Unlock UI)
-- ─────────────────────────────────────────────
local Sidebar = Instance.new("Frame", ScreenGui)
Sidebar.Name               = "Sidebar"
Sidebar.BackgroundColor3   = C.sidebarBg
Sidebar.BorderColor3       = C.border
Sidebar.BorderSizePixel    = 1
Sidebar.Position           = UDim2.new(0, 0, 0.28, 0)
Sidebar.Size               = UDim2.new(0, 90, 0, 72)
Sidebar.ZIndex             = 10

local function makeSideBtn(text, yOff)
    local b = Instance.new("TextButton", Sidebar)
    b.BackgroundColor3  = C.sidebarBg
    b.BorderColor3      = C.border
    b.BorderSizePixel   = 1
    b.Position          = UDim2.new(0, 0, 0, yOff)
    b.Size              = UDim2.new(1, 0, 0, 35)
    b.Font              = Enum.Font.SourceSansBold
    b.Text              = text
    b.TextColor3        = C.textMain
    b.TextSize          = 13
    b.ZIndex            = 11
    return b
end

local ToggleBtn  = makeSideBtn("Toggle UI",  0)
local UnlockBtn  = makeSideBtn("Unlock UI", 36)

-- ─────────────────────────────────────────────
--  MAIN WINDOW
-- ─────────────────────────────────────────────
local Win = Instance.new("Frame", ScreenGui)
Win.Name              = "MainWindow"
Win.BackgroundColor3  = C.bg
Win.BorderColor3      = C.border
Win.BorderSizePixel   = 2
Win.Position          = UDim2.new(0.5, -520, 0.5, -210)
Win.Size              = UDim2.new(0, 1040, 0, 420)
Win.Active            = true
Win.ZIndex            = 5

-- ── dragging ──
local drag, dragStart, winStart
Win.InputBegan:Connect(function(i)
    if Config.UILocked then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        drag      = true
        dragStart = i.Position
        winStart  = Win.Position
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then drag = false end
        end)
    end
end)
local lastDragInput
Win.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseMovement
    or i.UserInputType == Enum.UserInputType.Touch then
        lastDragInput = i
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if Config.UILocked then return end
    if i == lastDragInput and drag then
        local d = i.Position - dragStart
        Win.Position = UDim2.new(
            winStart.X.Scale, winStart.X.Offset + d.X,
            winStart.Y.Scale, winStart.Y.Offset + d.Y
        )
    end
end)

