-- ─────────────────────────────────────────────
--  SIDEBAR LOGIC
-- ─────────────────────────────────────────────
ToggleBtn.MouseButton1Click:Connect(function()
    Config.UIHidden = not Config.UIHidden
    Win.Visible     = not Config.UIHidden
    ToggleBtn.Text  = Config.UIHidden and "Open UI" or "Toggle UI"
end)
UnlockBtn.MouseButton1Click:Connect(function()
    Config.UILocked = not Config.UILocked
    UnlockBtn.Text  = Config.UILocked and "Lock UI" or "Unlock UI"
end)

-- ─────────────────────────────────────────────
--  CORE LOGIC
-- ─────────────────────────────────────────────

-- Desync: persistent offset, refreshed every 100ms
local desyncOffset = Vector3.new(0,0,0)
local desyncClock  = 0
RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if Config.Desync then
        desyncClock = desyncClock + dt
        if desyncClock >= 0.1 then
            desyncOffset = Vector3.new(
                math.random(-14,14), math.random(-4,4), math.random(-14,14)
            )
            desyncClock = 0
        end
        pcall(function() root.CFrame = root.CFrame + desyncOffset end)
    end
end)

-- Main per-frame loop
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root     = char:FindFirstChild("HumanoidRootPart")   -- fresh each frame
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    -- weapon patches
    if Config.RapidFire or Config.NoRecoil or Config.NoSpread then
        pcall(function()
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    for _, v in ipairs(tool:GetDescendants()) do
                        if v:IsA("NumberValue") or v:IsA("IntValue") then
                            local n = v.Name:lower()
                            if Config.RapidFire and (n:find("cooldown") or n:find("rate")) then v.Value = 0.01 end
                            if Config.NoRecoil  and (n:find("recoil")   or n:find("kick")) then v.Value = 0    end
                            if Config.NoSpread  and (n:find("spread")   or n:find("accuracy") or n:find("inaccuracy")) then v.Value = 0 end
                        end
                    end
                end
            end
        end)
    end

    -- fly
    if Config.Fly and humanoid and root then
        humanoid.PlatformStand = true
        local md = humanoid.MoveDirection
        root.AssemblyLinearVelocity = Vector3.new(
            md.X * Config.FlySpeed, 0, md.Z * Config.FlySpeed
        )
    elseif humanoid and humanoid.PlatformStand and not Config.Fly then
        humanoid.PlatformStand = false
    end

    -- speed
    if Config.SpeedHack and humanoid then
        humanoid.WalkSpeed = Config.WalkSpeed
    end

    -- noclip
    if Config.Noclip then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    -- fullbright
    if Config.FullBright then
        pcall(function()
            local L = game:GetService("Lighting")
            L.Brightness = 2; L.ClockTime = 14
            L.FogEnd = 100000; L.GlobalShadows = false
            L.Ambient = Color3.new(1,1,1)
        end)
    end
end)

-- Infinite Jump
UserInputService.JumpRequest:Connect(function()
    if not Config.InfiniteJump then return end
    local char = LocalPlayer.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- ESP  (BillboardGui pool, cleaned each frame)
RunService.RenderStepped:Connect(function()
    for _, v in ipairs(CoreGui:GetChildren()) do
        if v.Name == "DX_ESP" then v:Destroy() end
    end
    if not Config.ESPEnabled then return end
    local cam = workspace.CurrentCamera
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local r = plr.Character:FindFirstChild("HumanoidRootPart")
            if r then
                local _, onScreen = cam:WorldToViewportPoint(r.Position)
                if onScreen then
                    local tag = Instance.new("BillboardGui", CoreGui)
                    tag.Name        = "DX_ESP"
                    tag.Adornee     = r
                    tag.Size        = UDim2.new(0, 100, 0, 24)
                    tag.StudsOffset = Vector3.new(0, 3.5, 0)
                    tag.AlwaysOnTop = true
                    if Config.ESPNames then
                        local nl = Instance.new("TextLabel", tag)
                        nl.BackgroundTransparency = 1
                        nl.Size       = UDim2.new(1,0,1,0)
                        nl.Text       = plr.Name
                        nl.TextColor3 = Color3.fromRGB(255,80,80)
                        nl.TextSize   = IS_MOBILE and 16 or 13
                        nl.Font       = Enum.Font.SourceSansBold
                    end
                end
            end
        end
    end
end)

-- ─────────────────────────────────────────────
print(string.format("[DiamondX v1.1] Mobile=%s  WIN=%dx%d  TAP_H=%d",
    tostring(IS_MOBILE), WIN_W, WIN_H, TAP_H))
