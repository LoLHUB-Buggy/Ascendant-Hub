-- live fps / ping update
RunService.RenderStepped:Connect(function()
    local fps  = math.floor(1 / RunService.RenderStepped:Wait() * 10 + 0.5) / 10
    local ping = math.floor(Stats and Stats.Network and Stats.Network.ServerStatsItem and
                 Stats.Network.ServerStatsItem["Data Ping"] and
                 Stats.Network.ServerStatsItem["Data Ping"].Value or 0)
    TopStats.Text = string.format(
        "DiamondX | V1.0 (Beta) | Free | %d fps | %d ms", fps, ping
    )
end)

