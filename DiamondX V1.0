    RagebotEnabled = false,
    Orbit          = false,
    Desync         = false,
    AttackTick     = 1,   -- slider 1-10
    HideTick       = 1,   -- slider 1-10

    -- Wallbang (Main)
    Wallbang       = false,

    -- ESP
    ESPEnabled     = false,
    ESPBoxes       = false,
    ESPNames       = false,
    ESPHealth      = false,
    ESPTracers     = false,

    -- Visual
    NoRecoil       = false,
    NoSpread       = false,
    FullBright     = false,

    -- Character
    Fly            = false,
    FlySpeed       = 50,
    InfiniteJump   = false,
    Noclip         = false,
    SpeedHack      = false,
    WalkSpeed      = 16,

    -- Misc
    RapidFire      = false,
    FastAttack     = false,
    AutoParry      = false,

    -- UI
    UILocked       = false,
    UIHidden       = false,
}

-- ─────────────────────────────────────────────
