-- ─────────────────────────────────────────────
--  TAB BAR
-- ─────────────────────────────────────────────
local TabBar = Instance.new("Frame", Win)
TabBar.BackgroundTransparency = 1
TabBar.Position = UDim2.new(0, 8, 0, 34)
TabBar.Size     = UDim2.new(1, -16, 0, 30)
TabBar.ZIndex   = 6

local tabNames = {"Main","ESP","Visual","Character","Misc","UI Settings"}
local tabPages  = {}
local tabBtns   = {}

local TAB_W = 1 / #tabNames

for i, name in ipairs(tabNames) do
    -- button
    local tb = Instance.new("TextButton", TabBar)
    tb.BorderColor3      = C.border
    tb.BorderSizePixel   = 1
    tb.BackgroundColor3  = (i==1) and C.tabActive or C.tabInactive
    tb.Position  = UDim2.new((i-1)*TAB_W, 1, 0, 0)
    tb.Size      = UDim2.new(TAB_W, -2, 1, 0)
    tb.Font      = Enum.Font.SourceSansBold
    tb.Text      = name
    tb.TextColor3 = C.textMain
    tb.TextSize  = 12
    tb.ZIndex    = 7
    tabBtns[name] = tb

    -- page (scrolling)
    local pg = Instance.new("ScrollingFrame", Win)
    pg.Name                = name.."Page"
    pg.BackgroundColor3    = C.panel
    pg.BorderColor3        = C.border
    pg.BorderSizePixel     = 1
    pg.Position            = UDim2.new(0, 8, 0, 68)
    pg.Size                = UDim2.new(1, -16, 1, -76)
    pg.CanvasSize          = UDim2.new(0, 0, 0, 500)
    pg.ScrollBarThickness  = 4
    pg.ScrollBarImageColor3 = C.sliderFill
    pg.Visible             = (i==1)
    pg.ZIndex              = 6
    tabPages[name] = pg

    tb.MouseButton1Click:Connect(function()
        for n,p in pairs(tabPages) do p.Visible = (n==name) end
        for n,b in pairs(tabBtns)  do
            b.BackgroundColor3 = (n==name) and C.tabActive or C.tabInactive
        end
    end)
end

-- ─────────────────────────────────────────────
--  WIDGET HELPERS
-- ─────────────────────────────────────────────

-- Group box (labeled border box like in screenshot)
local function GroupBox(parent, title, w, h, x, y)
    local f = Instance.new("Frame", parent)
    f.BackgroundColor3 = C.groupBg
    f.BorderColor3     = C.border
    f.BorderSizePixel  = 1
    f.Position = UDim2.new(0, x, 0, y)
    f.Size     = UDim2.new(0, w, 0, h)
    f.ZIndex   = 7

    local lbl = Instance.new("TextLabel", f)
    lbl.BackgroundTransparency = 1
    lbl.Position  = UDim2.new(0, 10, 0, 6)
    lbl.Size      = UDim2.new(1, -14, 0, 18)
    lbl.Font      = Enum.Font.SourceSansBold
    lbl.Text      = title
    lbl.TextColor3 = C.textHeader
    lbl.TextSize  = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex    = 8
    return f
end

-- Checkbox toggle
local function Checkbox(parent, label, configKey, y)
    local box = Instance.new("TextButton", parent)
    box.BackgroundColor3 = Config[configKey] and C.checkOn or C.checkOff
    box.BorderColor3     = C.border
    box.BorderSizePixel  = 1
    box.Position = UDim2.new(0, 10, 0, y)
    box.Size     = UDim2.new(0, 14, 0, 14)
    box.Text     = ""
    box.ZIndex   = 9

    local lbl = Instance.new("TextLabel", parent)
    lbl.BackgroundTransparency = 1
    lbl.Position  = UDim2.new(0, 30, 0, y - 2)
    lbl.Size      = UDim2.new(1, -36, 0, 18)
    lbl.Font      = Enum.Font.SourceSans
    lbl.Text      = label
    lbl.TextColor3 = C.textMain
    lbl.TextSize  = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex    = 9

    box.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        box.BackgroundColor3 = Config[configKey] and C.checkOn or C.checkOff
    end)
    return box
end

-- Horizontal slider  (returns frame, value label)
local function Slider(parent, label, configKey, minV, maxV, y)
    local TRACK_W = 160

    local lbl = Instance.new("TextLabel", parent)
    lbl.BackgroundTransparency = 1
    lbl.Position  = UDim2.new(0, 10, 0, y)
    lbl.Size      = UDim2.new(0, TRACK_W, 0, 14)
    lbl.Font      = Enum.Font.SourceSans
    lbl.Text      = label .. ": " .. tostring(Config[configKey])
    lbl.TextColor3 = C.textMain
    lbl.TextSize  = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex    = 9

    local track = Instance.new("Frame", parent)
    track.BackgroundColor3 = C.sliderBg
    track.BorderColor3     = C.border
    track.BorderSizePixel  = 1
    track.Position = UDim2.new(0, 10, 0, y + 16)
    track.Size     = UDim2.new(0, TRACK_W, 0, 14)
    track.ZIndex   = 9

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = C.sliderFill
    fill.BorderSizePixel  = 0
    fill.Size  = UDim2.new((Config[configKey] - minV)/(maxV - minV), 0, 1, 0)
    fill.ZIndex = 10

    -- drag logic
    local sliding = false
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true
        end
    end)
    track.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not sliding then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement
        and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local absPos = track.AbsolutePosition.X
        local absSize = track.AbsoluteSize.X
        local rel = math.clamp((i.Position.X - absPos) / absSize, 0, 1)
        local val = math.floor(rel * (maxV - minV) + minV + 0.5)
        Config[configKey] = val
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text  = label .. ": " .. tostring(val)
    end)
end

