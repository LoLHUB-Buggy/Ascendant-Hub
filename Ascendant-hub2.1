        Name = "MainFrame",
        Parent = screenGui,
        BackgroundColor3 = Ascendant.Theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(0.5, -frameWidth/2, 0.5, -frameHeight/2),
        Size = UDim2.new(0, frameWidth, 0, frameHeight),
