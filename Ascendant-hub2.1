local Features = {}

function Features:Init()
    -- FOV circle
    local fov = Drawing.new("Circle")
    fov.Visible = false
    fov.Thickness = 1.2
    fov.Color = Color3.fromRGB(255, 255, 255)
    fov.Transparency = 0.7
    fov.NumSides = 64
    fov.Radius = Ascendant.Config.SilentAim.FOVRadius
    fov.Filled = false
    Ascendant.Runtime.FOVDrawing = fov

    -- Crosshair lines (top, bottom, left, right)
    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Visible = Ascendant.Config.Visual.Crosshair
        line.Thickness = 1.5
        line.Color = Ascendant.Config.Visual.CrosshairColor
        line.Transparency = 0.9
        table.insert(Ascendant.Runtime.CrosshairDrawings, line)
    end

    RunService.RenderStepped:Connect(function(dt)
        self:UpdateFOV()
        self:UpdateCrosshair()
        self:UpdateESP()
        self:SilentAimStep()
        self:RagebotStep(dt)
        self:AutoShootStep()
    end)

    -- Infinite jump
    UserInputService.JumpRequest:Connect(function()
        if Ascendant.Config.Character.InfiniteJump then
            local hum = Utility:GetHumanoid(LocalPlayer.Character)
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    -- Anti-AFK
    task.spawn(function()
        while task.wait(60) do
            if Ascendant.Config.Misc.AntiAFK then
                VirtualUser:Button2Down(Vector2.new(0,0), Camera.CFrame)
                task.wait(0.1)
                VirtualUser:Button2Up(Vector2.new(0,0), Camera.CFrame)
            end
        end
    end)
end

function Features:UpdateFOV()
    local fov = Ascendant.Runtime.FOVDrawing
    if not fov then return end
    fov.Visible = Ascendant.Config.SilentAim.ShowFOV and Ascendant.Config.SilentAim.Enabled
    fov.Position = Vector2.new(Mouse.X, Mouse.Y + 36)
    fov.Radius = Ascendant.Config.SilentAim.FOVRadius
end

function Features:UpdateCrosshair()
    local size = Ascendant.Config.Visual.CrosshairSize
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local d = Ascendant.Runtime.CrosshairDrawings
    if #d < 4 then return end

    d[1].From = Vector2.new(center.X - size - 2, center.Y)
    d[1].To   = Vector2.new(center.X - 2, center.Y)
    d[2].From = Vector2.new(center.X + 2, center.Y)
    d[2].To   = Vector2.new(center.X + size + 2, center.Y)
    d[3].From = Vector2.new(center.X, center.Y - size - 2)
    d[3].To   = Vector2.new(center.X, center.Y - 2)
    d[4].From = Vector2.new(center.X, center.Y + 2)
    d[4].To   = Vector2.new(center.X, center.Y + size + 2)

    for _, line in ipairs(d) do
        line.Visible = Ascendant.Config.Visual.Crosshair
        line.Color = Ascendant.Config.Visual.CrosshairColor
    end
end

function Features:GetTarget()
    local closest = nil
    local shortest = math.huge
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if Ascendant.Config.SilentAim.TeamCheck and Utility:IsTeamMate(player) then continue end

        local character = Utility:GetCharacter(player)
        local part = character and character:FindFirstChild(Ascendant.Config.SilentAim.TargetPart)
        if not part then continue end

        local screenPos, onScreen = Utility:WorldToScreen(part.Position)
        if not onScreen then continue end

        local distToMouse = (screenPos - mousePos).Magnitude
        if distToMouse > Ascendant.Config.SilentAim.FOVRadius and not Ascendant.Config.SilentAim.IgnoreFOV then continue end

        local worldDist = Utility:GetDistance(part.Position)
        if worldDist < shortest then
            shortest = worldDist
            closest = part
        end
    end

    return closest
end

function Features:SilentAimStep()
    if not Ascendant.Config.SilentAim.Enabled then return end
    local target = self:GetTarget()
    if target then
        Ascendant.Runtime.CurrentTarget = target
    end
end

function Features:RagebotStep(dt)
    if not Ascendant.Config.Ragebot.Enabled then return end

    local character = LocalPlayer.Character
    local hrp = Utility:GetRootPart(character)
    if not hrp then return end

    if not Ascendant.Runtime.CurrentTarget or not Ascendant.Runtime.CurrentTarget.Parent then
        Ascendant.Runtime.CurrentTarget = self:GetTarget()
    end
    local target = Ascendant.Runtime.CurrentTarget
    if not target then return end

    -- *orbital mechanics: the socket registers 0.016s of arc every frame,
    --  ticking the angle forward by speed*dt. the math.cos/sin pair is the
    --  orbit's heartbeat — two perpendicular sinusoids 90° out of phase,
    --  tracing a circle in XZ space around whatever the target part
    --  happens to occupy this tick.*
    Ascendant.Runtime.OrbitAngle = Ascendant.Runtime.OrbitAngle
        + (Ascendant.Config.Ragebot.OrbitSpeed * dt)

    local r  = Ascendant.Config.Ragebot.OrbitRadius
    local tp = target.Position
    local orbitPos = Vector3.new(
        tp.X + math.cos(Ascendant.Runtime.OrbitAngle) * r,
        tp.Y + Ascendant.Config.Ragebot.OrbitHeight + Ascendant.Config.Ragebot.HeightAdjust,
        tp.Z + math.sin(Ascendant.Runtime.OrbitAngle) * r
    )

    hrp.CFrame = CFrame.new(orbitPos, tp)
    hrp.Velocity = Vector3.zero
    hrp.RotVelocity = Vector3.zero

    if Ascendant.Config.Ragebot.AutoShoot then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end
end

function Features:AutoShootStep()
    if not Ascendant.Config.Misc.AutoShoot then return end
    local character = LocalPlayer.Character
    if not character then return end
    local tool = character:FindFirstChildOfClass("Tool")
    if tool and self:GetTarget() then
        tool:Activate()
    end
end

function Features:UpdateESP()
    if not Ascendant.Config.ESP.Enabled then
        for _, obj in pairs(Ascendant.Runtime.ESPObjects) do
            for _, drawing in pairs(obj) do
                drawing.Visible = false
            end
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if Ascendant.Config.ESP.TeamCheck and Utility:IsTeamMate(player) then
            self:HideESP(player); continue
        end

        local character = Utility:GetCharacter(player)
        if not character then self:HideESP(player); continue end

        local hrp  = Utility:GetRootPart(character)
        local head = character:FindFirstChild("Head")
        local hum  = Utility:GetHumanoid(character)
        if not hrp or not head or not hum then self:HideESP(player); continue end

        if Utility:GetDistance(hrp.Position) > Ascendant.Config.ESP.MaxDistance then
            self:HideESP(player); continue
        end

        if Ascendant.Config.ESP.VisibleOnly then
            local visible = Utility:RaycastVisible(Camera.CFrame.Position, head.Position, {LocalPlayer.Character, character})
            if not visible then self:HideESP(player); continue end
        end

        self:DrawESP(player, character, hrp, head, hum)
    end
end

function Features:GetESPObject(player)
    if Ascendant.Runtime.ESPObjects[player] then
        return Ascendant.Runtime.ESPObjects[player]
    end

    local obj = {}

    if Ascendant.Config.ESP.Boxes then
        local box = Drawing.new("Square")
        box.Thickness = 1
        box.Filled = false
        box.Color = Ascendant.Config.ESP.BoxColor
        obj.Box = box
    end

    if Ascendant.Config.ESP.HealthBars then
        local bar = Drawing.new("Line")
        bar.Thickness = 2
        obj.HealthBar = bar
    end

    if Ascendant.Config.ESP.Names then
        local name = Drawing.new("Text")
        name.Size = 13
        name.Font = Drawing.Fonts.UI
        name.Center = true
        name.Outline = true
        name.Color = Color3.new(1, 1, 1)
        obj.Name = name
    end

    if Ascendant.Config.ESP.Tracers then
        local tracer = Drawing.new("Line")
        tracer.Thickness = 1
        tracer.Color = Ascendant.Config.ESP.BoxColor
        obj.Tracer = tracer
    end

    Ascendant.Runtime.ESPObjects[player] = obj
    return obj
end

function Features:HideESP(player)
    local obj = Ascendant.Runtime.ESPObjects[player]
    if not obj then return end
    for _, drawing in pairs(obj) do
        drawing.Visible = false
    end
end

function Features:DrawESP(player, character, hrp, head, hum)
    local obj = self:GetESPObject(player)

    local headScreen, headOn = Utility:WorldToScreen(head.Position)
    local footScreen, footOn = Utility:WorldToScreen(hrp.Position - Vector3.new(0, 3, 0))

    if not headOn or not footOn then
        self:HideESP(player); return
    end

    local boxH = math.abs(footScreen.Y - headScreen.Y)
    local boxW = boxH * 0.55

    if obj.Box then
        obj.Box.Visible = true
        obj.Box.Size    = Vector2.new(boxW, boxH)
        obj.Box.Position = Vector2.new(headScreen.X - boxW / 2, headScreen.Y)
        obj.Box.Color   = Ascendant.Config.ESP.BoxColor
    end

    if obj.HealthBar then
        local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        obj.HealthBar.Visible = true
        obj.HealthBar.From  = Vector2.new(headScreen.X - boxW / 2 - 6, footScreen.Y)
        obj.HealthBar.To    = Vector2.new(headScreen.X - boxW / 2 - 6, footScreen.Y - boxH * hp)
        obj.HealthBar.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 50)
    end

    if obj.Name then
        obj.Name.Visible  = true
        obj.Name.Position = Vector2.new(headScreen.X, headScreen.Y - 16)
        obj.Name.Text     = player.Name
    end

    if obj.Tracer then
        obj.Tracer.Visible = true
        obj.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        obj.Tracer.To   = Vector2.new(headScreen.X, footScreen.Y)
        obj.Tracer.Color = Ascendant.Config.ESP.BoxColor
    end
end

function Features:EnableFly()
    if Ascendant.Runtime.FlyConnection then return end
    local character = LocalPlayer.Character
    local hrp = Utility:GetRootPart(character)
    if not hrp then return end

    -- *bodyGyro holds attitude; bodyVel holds velocity —
    --  together they make the HRP float like it owns the sky.*
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.P = 9e4
    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.CFrame = hrp.CFrame
    bodyGyro.Parent = hrp

    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Velocity = Vector3.zero
    bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVel.Parent = hrp

    Ascendant.Runtime.FlyConnection = RunService.RenderStepped:Connect(function()
        if not Ascendant.Config.Character.Fly then
            self:DisableFly()
            return
        end
        local cam = Camera.CFrame
        local dir = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end

        bodyVel.Velocity = dir.Magnitude > 0 and dir.Unit * Ascendant.Config.Character.FlySpeed or Vector3.zero
        bodyGyro.CFrame = cam
    end)
end

function Features:DisableFly()
    if Ascendant.Runtime.FlyConnection then
        Ascendant.Runtime.FlyConnection:Disconnect()
        Ascendant.Runtime.FlyConnection = nil
    end
    local hrp = Utility:GetRootPart(LocalPlayer.Character)
    if hrp then
        for _, child in ipairs(hrp:GetChildren()) do
            if child:IsA("BodyGyro") or child:IsA("BodyVelocity") then
                child:Destroy()
            end
        end
    end
end

function Features:EnableNoClip()
    if Ascendant.Runtime.NoClipConnection then return end
    Ascendant.Runtime.NoClipConnection = RunService.Stepped:Connect(function()
        if not Ascendant.Config.Character.NoClip then
            self:DisableNoClip()
            return
        end
        local character = LocalPlayer.Character
        if not character then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

function Features:DisableNoClip()
    if Ascendant.Runtime.NoClipConnection then
        Ascendant.Runtime.NoClipConnection:Disconnect()
        Ascendant.Runtime.NoClipConnection = nil
    end
end

function Features:EnableAntiAim()
    if Ascendant.Runtime.AntiAimConnection then return end
    Ascendant.Runtime.AntiAimConnection = RunService.RenderStepped:Connect(function()
        if not Ascendant.Config.Character.AntiAim then
            self:DisableAntiAim()
            return
        end
        local hrp = Utility:GetRootPart(LocalPlayer.Character)
        if not hrp then return end
        hrp.CFrame = hrp.CFrame * CFrame.Angles(
            math.random(-10, 10) / 100,
            math.random(-180, 180) / 100,
            0
        )
    end)
end

function Features:DisableAntiAim()
    if Ascendant.Runtime.AntiAimConnection then
        Ascendant.Runtime.AntiAimConnection:Disconnect()
        Ascendant.Runtime.AntiAimConnection = nil
    end
end

function Features:Cleanup()
    self:DisableFly()
    self:DisableNoClip()
    self:DisableAntiAim()

    if Ascendant.Runtime.FOVDrawing then
        Ascendant.Runtime.FOVDrawing:Remove()
    end
    for _, d in ipairs(Ascendant.Runtime.CrosshairDrawings) do
        pcall(function() d:Remove() end)
    end
    for _, obj in pairs(Ascendant.Runtime.ESPObjects) do
        for _, drawing in pairs(obj) do
            pcall(function() drawing:Remove() end)
        end
    end
end

