                titleText.Text = Ascendant.Name .. " | " .. Ascendant.Version .. " | Free | " .. fps .. " fps | " .. ping .. " ms"
            end
        end
    end)

    local subtitle = Utility:Create("TextLabel", {
        Name = "Subtitle",
        Parent = titleBar,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 24),
        Size = UDim2.new(0.8, 0, 0, 16),
        Font = Enum.Font.Gotham,
        Text = Ascendant.Name .. " - https://discord.gg/ascendant",
        TextColor3 = Ascendant.Theme.TextDim,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local closeBtn = Utility:Create("TextButton", {
