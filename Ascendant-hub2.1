function UI:CreateToggle(parent, text, configKey, configTable, callback)
    local toggle = Utility:Create("Frame", {
        Parent = parent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 26)
    })

    local enabled = configTable and configTable[configKey] or false

    local box = Utility:Create("Frame", {
        Parent = toggle,
        BackgroundColor3 = enabled and Ascendant.Theme.Accent or Ascendant.Theme.Border,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0.5, -9),
        Size = UDim2.new(0, 18, 0, 18)
    })
    Utility:Create("UICorner", {Parent = box, CornerRadius = UDim.new(0, 3)})

    local check = Utility:Create("TextLabel", {
        Parent = box,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = "✓",
        TextColor3 = Color3.new(1,1,1),
        TextSize = 12,
        TextTransparency = enabled and 0 or 1
    })

    local label = Utility:Create("TextLabel", {
        Parent = toggle,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 26, 0, 0),
        Size = UDim2.new(1, -26, 1, 0),
        Font = Enum.Font.Gotham,
        Text = text,
        TextColor3 = Ascendant.Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    toggle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            enabled = not enabled
            if configTable and configKey then
                configTable[configKey] = enabled
            end
            Utility:Tween(box, nil, {BackgroundColor3 = enabled and Ascendant.Theme.Accent or Ascendant.Theme.Border})
            check.TextTransparency = enabled and 0 or 1
            if callback then callback(enabled) end
        end
    end)

    return toggle
end

function UI:CreateSlider(parent, text, configKey, configTable, min, max, decimals, callback)
    local sliderFrame = Utility:Create("Frame", {
        Parent = parent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 42)
    })

    local label = Utility:Create("TextLabel", {
        Parent = sliderFrame,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.5, 0, 0, 18),
        Font = Enum.Font.Gotham,
        Text = text,
        TextColor3 = Ascendant.Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local valueLabel = Utility:Create("TextLabel", {
        Parent = sliderFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0.5, 0, 0, 0),
        Size = UDim2.new(0.5, 0, 0, 18),
        Font = Enum.Font.GothamBold,
        Text = tostring(configTable[configKey]) .. "/" .. tostring(max),
        TextColor3 = Ascendant.Theme.Accent,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right
    })

    local track = Utility:Create("Frame", {
        Parent = sliderFrame,
        BackgroundColor3 = Ascendant.Theme.Border,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 26),
        Size = UDim2.new(1, 0, 0, 6)
    })
    Utility:Create("UICorner", {Parent = track, CornerRadius = UDim.new(1, 0)})

    local fill = Utility:Create("Frame", {
        Parent = track,
        BackgroundColor3 = Ascendant.Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new((configTable[configKey] - min) / (max - min), 0, 1, 0)
    })
    Utility:Create("UICorner", {Parent = fill, CornerRadius = UDim.new(1, 0)})

    local knob = Utility:Create("Frame", {
        Parent = track,
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Position = UDim2.new((configTable[configKey] - min) / (max - min), -8, 0.5, -8),
        Size = UDim2.new(0, 16, 0, 16)
    })
    Utility:Create("UICorner", {Parent = knob, CornerRadius = UDim.new(1, 0)})

    local dragging = false
    local function update(input)
        local pos = input.Position.X
        local trackPos = track.AbsolutePosition.X
        local trackSize = track.AbsoluteSize.X
        local relative = math.clamp((pos - trackPos) / trackSize, 0, 1)
        local value = min + (relative * (max - min))
        if decimals then
            value = Utility:Round(value, decimals)
        else
            value = math.floor(value)
        end
        configTable[configKey] = value
        fill.Size = UDim2.new(relative, 0, 1, 0)
        knob.Position = UDim2.new(relative, -8, 0.5, -8)
        valueLabel.Text = tostring(value) .. "/" .. tostring(max)
        if callback then callback(value) end
    end

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            update(input)
        end
    end)

    return sliderFrame
end

function UI:CreateDropdown(parent, text, configKey, configTable, options, callback)
    local dropFrame = Utility:Create("Frame", {
        Parent = parent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 56)
    })

    local label = Utility:Create("TextLabel", {
        Parent = dropFrame,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        Font = Enum.Font.Gotham,
        Text = text,
        TextColor3 = Ascendant.Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local btn = Utility:Create("TextButton", {
        Parent = dropFrame,
        BackgroundColor3 = Ascendant.Theme.Surface,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 22),
        Size = UDim2.new(1, 0, 0, 32),
        Font = Enum.Font.GothamSemibold,
        Text = configTable[configKey],
        TextColor3 = Ascendant.Theme.Text,
        TextSize = 12
    })
    Utility:Create("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 4)})

    local arrow = Utility:Create("TextLabel", {
        Parent = btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -28, 0, 0),
        Size = UDim2.new(0, 24, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = "v",
        TextColor3 = Ascendant.Theme.TextDim,
        TextSize = 10
    })

    local open = false
    local optionFrame = Utility:Create("Frame", {
        Parent = dropFrame,
        BackgroundColor3 = Ascendant.Theme.Surface,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 56),
        Size = UDim2.new(1, 0, 0, 0),
        ClipsDescendants = true,
        Visible = false,
        ZIndex = 5
    })
    Utility:Create("UICorner", {Parent = optionFrame, CornerRadius = UDim.new(0, 4)})

    for _, opt in ipairs(options) do
        local optBtn = Utility:Create("TextButton", {
            Parent = optionFrame,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 28),
            Font = Enum.Font.Gotham,
            Text = opt,
            TextColor3 = Ascendant.Theme.Text,
            TextSize = 12
        })
        optBtn.MouseButton1Click:Connect(function()
            configTable[configKey] = opt
            btn.Text = opt
            open = false
            optionFrame.Visible = false
            arrow.Text = "v"
            if callback then callback(opt) end
        end)
    end

    btn.MouseButton1Click:Connect(function()
        open = not open
        optionFrame.Visible = open
        arrow.Text = open and "^" or "v"
        optionFrame.Size = open and UDim2.new(1, 0, 0, #options * 28) or UDim2.new(1, 0, 0, 0)
    end)

    return dropFrame
end

