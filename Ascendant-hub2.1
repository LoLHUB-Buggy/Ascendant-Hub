function UI:CreateColorPicker(parent, text, callback)
    local frame = Utility:Create("Frame", {
        Parent = parent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 26)
    })

    local label = Utility:Create("TextLabel", {
        Parent = frame,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.7, 0, 1, 0),
        Font = Enum.Font.Gotham,
        Text = text,
        TextColor3 = Ascendant.Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local colorBtn = Utility:Create("TextButton", {
        Parent = frame,
        BackgroundColor3 = Ascendant.Theme.Accent,
        BorderSizePixel = 0,
        Position = UDim2.new(0.75, 0, 0.5, -10),
        Size = UDim2.new(0.25, 0, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = "",
        TextColor3 = Color3.new(1,1,1),
        TextSize = 10
    })
    Utility:Create("UICorner", {Parent = colorBtn, CornerRadius = UDim.new(0, 4)})

    colorBtn.MouseButton1Click:Connect(function()
        local colors = {Color3.fromRGB(124,77,255), Color3.fromRGB(220,20,60), Color3.fromRGB(50,205,50), Color3.fromRGB(255,180,60), Color3.fromRGB(255,255,255)}
        local current = colorBtn.BackgroundColor3
        local nextIdx = 1
        for i, c in ipairs(colors) do
            if c == current then nextIdx = (i % #colors) + 1; break end
        end
        colorBtn.BackgroundColor3 = colors[nextIdx]
        if callback then callback(colors[nextIdx]) end
    end)

    return frame
end

