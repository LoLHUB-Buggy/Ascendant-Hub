        end
    end)

    -- Tab container
    local tabBar = Utility:Create("Frame", {
        Name = "TabBar",
        Parent = mainFrame,
        BackgroundColor3 = Ascendant.Theme.Surface,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 38),
        Size = UDim2.new(1, 0, 0, 36)
    })

    local tabContent = Utility:Create("Frame", {
        Name = "TabContent",
        Parent = mainFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 8, 0, 82),
        Size = UDim2.new(1, -16, 1, -90)
    })

    local tabs = {"Main", "ESP", "Visual", "Character", "Misc", "UI Settings"}
    local tabButtons = {}
    local tabFrames = {}

    for i, tabName in ipairs(tabs) do
        local btn = Utility:Create("TextButton", {
            Name = tabName .. "Tab",
            Parent = tabBar,
            BackgroundColor3 = i == 1 and Ascendant.Theme.Accent or Ascendant.Theme.Surface,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 8 + ((i-1) * 100 * scale), 0, 4),
            Size = UDim2.new(0, 90 * scale, 0, 28),
            Font = Enum.Font.GothamSemibold,
            Text = tabName,
            TextColor3 = i == 1 and Color3.new(1,1,1) or Ascendant.Theme.TextDim,
            TextSize = 12
        })
        Utility:Create("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 4)})

        tabButtons[tabName] = btn

        local frame = Utility:Create("ScrollingFrame", {
            Name = tabName .. "Content",
            Parent = tabContent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 1, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Ascendant.Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 800),
            Visible = i == 1
        })
        Utility:Create("UIListLayout", {
            Parent = frame,
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder
        })
        tabFrames[tabName] = frame

        btn.MouseButton1Click:Connect(function()
            if Ascendant.Runtime.ActiveTab == tabName then return end
            local oldBtn = tabButtons[Ascendant.Runtime.ActiveTab]
            if oldBtn then
                Utility:Tween(oldBtn, nil, {BackgroundColor3 = Ascendant.Theme.Surface})
                oldBtn.TextColor3 = Ascendant.Theme.TextDim
            end
            tabFrames[Ascendant.Runtime.ActiveTab].Visible = false

            Ascendant.Runtime.ActiveTab = tabName
            Utility:Tween(btn, nil, {BackgroundColor3 = Ascendant.Theme.Accent})
            btn.TextColor3 = Color3.new(1,1,1)
            frame.Visible = true
        end)
    end

    Ascendant.Runtime.ScreenGui = screenGui
    Ascendant.Runtime.MainFrame = mainFrame
    Ascendant.Runtime.TabFrames = tabFrames

    self:MakeDraggable(titleBar, mainFrame)

    self:BuildMainTab(tabFrames.Main)
    self:BuildESPTab(tabFrames.ESP)
    self:BuildVisualTab(tabFrames.Visual)
    self:BuildCharacterTab(tabFrames.Character)
    self:BuildMiscTab(tabFrames.Misc)
    self:BuildUISettingsTab(tabFrames["UI Settings"])

    if Ascendant.Runtime.IsMobile then
        self:CreateMobileToggle(screenGui)
    end

    if Ascendant.Config.UI.ShowWatermark then
        self:CreateWatermark(screenGui)
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Ascendant.Config.UI.Keybind then
            mainFrame.Visible = not mainFrame.Visible
        end
    end)

    return screenGui
end

function UI:MakeDraggable(dragHandle, frame)
    local dragging = false
    local dragStart, startPos

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

