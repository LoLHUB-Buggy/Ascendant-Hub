        Parent = titleBar,
        BackgroundColor3 = Ascendant.Theme.Warning,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -62, 0, 6),
        Size = UDim2.new(0, 26, 0, 26),
        Font = Enum.Font.GothamBold,
        Text = "-",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14
    })
    Utility:Create("UICorner", {Parent = minBtn, CornerRadius = UDim.new(0, 4)})

    local minimized = false
