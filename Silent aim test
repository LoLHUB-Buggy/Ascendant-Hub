function TargetModule.new()
    local self = setmetatable({}, {__index = TargetModule})
    self.targets = {}
    self.current_target = nil
    return self
end

function TargetModule:GetPlayers()
    local players = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
            local character = player.Character
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local head = character:FindFirstChild("Head")
                    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
                    local distance = (rootPart.Position - Camera.CFrame.Position).Magnitude
                    local visible = self:IsVisible(rootPart)
                    table.insert(players, {
                        Player = player,
                        Character = character,
                        Humanoid = humanoid,
                        RootPart = rootPart,
                        Head = head,
                        Torso = torso,
                        Distance = distance,
                        Visible = visible,
                        Position = rootPart.Position
                    })
                end
            end
        end
    end
    return players
end

function TargetModule:IsVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin).Unit
    local ray = Ray.new(origin, direction * (part.Position - origin).Magnitude)
    local hit, position = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, Camera})
    if hit then
        local distanceToHit = (position - origin).Magnitude
        local distanceToTarget = (part.Position - origin).Magnitude
        return distanceToHit >= distanceToTarget - 2
    end
    return true
end

function TargetModule:GetClosestTarget()
    local players = self:GetPlayers()
    local closest = nil
    local closestDistance = math.huge
    for _, player in ipairs(players) do
        if player.Visible then
            local distance = player.Distance
            if distance < closestDistance then
                closestDistance = distance
                closest = player
            end
        end
    end
    return closest
end

function SilentAimModule.new()
    local self = setmetatable({}, {__index = SilentAimModule})
    self.enabled = false
    self.hit_chance = 100
    self.fov_radius = 200
    self.smoothness = 3
    self.target_part = "Head"
    self.target_module = TargetModule.new()
    self.last_update = 0
    self.update_rate = 0.05
    return self
end

function SilentAimModule:Toggle()
    self.enabled = not self.enabled
    return self.enabled
end

function SilentAimModule:GetTargetPosition(target)
    if not target then return nil end
    if self.target_part == "Head" and target.Head then
        return target.Head.Position
    elseif self.target_part == "Torso" and target.Torso then
        return target.Torso.Position
    elseif target.RootPart then
        return target.RootPart.Position
    end
    return nil
end

function SilentAimModule:CalculateAngle(current, target)
    local delta = target - current
    local magnitude = delta.Magnitude
    if magnitude < 0.1 then return nil end
    local pitch = math.asin(delta.Y / magnitude)
    local yaw = math.atan2(-delta.X, -delta.Z)
    return Vector3.new(pitch, yaw, 0)
end}

function SilentAimModule:ApplySilentAim()
    if not self.enabled then return end
    local currentTime = tick()
    if currentTime - self.last_update < self.update_rate then return end
    self.last_update = currentTime
    
    local target = self.target_module:GetClosestTarget()
    if not target then return end
    
    local targetPos = self:GetTargetPosition(target)
    if not targetPos then return end
    
    local hitChance = math.random(1, 100)
    if hitChance > self.hit_chance then return end
    
    local cameraPos = Camera.CFrame.Position
    local direction = (targetPos - cameraPos).Unit
    local angle = self:CalculateAngle(cameraPos, targetPos)
    if not angle then return end
    
    local newCFrame = CFrame.new(cameraPos, targetPos)
    Camera.CFrame = Camera.CFrame:Lerp(newCFrame, self.smoothness / 100)
end

function SilentAimModule:SetHitChance(value)
    self.hit_chance = math.clamp(value, 1, 100)
end

function SilentAimModule:SetFOV(value)
    self.fov_radius = math.clamp(value, 0, 360)
end

function SilentAimModule:SetSmoothness(value)
    self.smoothness = math.clamp(value, 0, 20)
end

function SilentAimModule:SetTargetPart(part)
    self.target_part = part
end

