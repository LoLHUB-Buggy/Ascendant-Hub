--  [11] CHEAT LOGIC — PROJECTILE REDIRECT
-- ============================================================
local function RunProjectileRedirect()
    if not S.proj_redirect then return end
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end
    local bestDist, bestPos = math.huge, nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local root, hum, _ = GetCharParts(player)
        if not root or not hum or hum.Health <= 0 then continue end
        local d = Dist3(localRoot.Position, root.Position)
        if d < bestDist then bestDist=d; bestPos=root.Position end
    end
    if not bestPos then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            for _, tn in ipairs(THROWABLE_NAMES) do
                if obj.Name:lower():find(tn:lower()) and obj.AssemblyLinearVelocity.Magnitude > 2 then
                    local dir   = (bestPos - obj.Position).Unit
                    local speed = obj.AssemblyLinearVelocity.Magnitude
                    pcall(function() obj.AssemblyLinearVelocity = dir * speed end)
                end
            end
        end
    end
end

