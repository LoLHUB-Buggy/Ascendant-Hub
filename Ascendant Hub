local function ND(t, p)
    local d = Drawing.new(t)
    for k, v in pairs(p) do d[k] = v end
    return d
end

local function GD(player)
    if DrawPool[player] then return DrawPool[player] end
    DrawPool[player] = {
        box      = ND("Square",   {Visible=false, Filled=false, Thickness=1}),
        boxFill  = ND("Square",   {Visible=false, Filled=true}),
        name     = ND("Text",     {Visible=false, Size=13, Center=true, Outline=true, OutlineColor=Color3.new()}),
        hpText   = ND("Text",     {Visible=false, Size=11, Center=true, Outline=true, OutlineColor=Color3.new()}),
        dist     = ND("Text",     {Visible=false, Size=11, Center=true, Outline=true, OutlineColor=Color3.new(), Color=Color3.fromRGB(200,200,200)}),
        weapon   = ND("Text",     {Visible=false, Size=11, Center=true, Outline=true, OutlineColor=Color3.new(), Color=Color3.fromRGB(255,220,100)}),
        hpBack   = ND("Square",   {Visible=false, Filled=true, Color=Color3.fromRGB(20,20,20)}),
        hpFill   = ND("Square",   {Visible=false, Filled=true}),
        lookDir  = ND("Line",     {Visible=false, Thickness=1, Color=Color3.fromRGB(0,255,180)}),
        arrow    = ND("Triangle", {Visible=false, Filled=true}),
        arrowOut = ND("Triangle", {Visible=false, Filled=false, Thickness=1}),
