    return DrawPool[player]
end

local function HideD(d)
    for _, o in pairs(d) do if o and o.Visible ~= nil then o.Visible = false end end
end

local function CleanupD(player)
    local d = DrawPool[player]
    if not d then return end
    for _, o in pairs(d) do if o and o.Remove then o:Remove() end end
    DrawPool[player] = nil
end

local function GetThrowDraw(obj)
