    Corner(btn,2); Stroke(btn, T.BORDER); Pad(btn,4)
    New("TextLabel", {Text="▾", Font=T.FONT, TextSize=T.FONT_SZ, TextColor3=T.ACCENT2, BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Right, Size=UDim2.new(1,-4,1,0), Parent=btn})
    local menuFrame = nil
    btn.MouseButton1Click:Connect(function()
        if menuFrame then menuFrame:Destroy(); menuFrame=nil; return end
        menuFrame = New("Frame", {BackgroundColor3=T.BG2, Size=UDim2.new(1,0,0,#options*16), Position=UDim2.new(0,0,1,1), ZIndex=20, Parent=btn})
        Corner(menuFrame,2); Stroke(menuFrame, T.ACCENT); ListLayout(menuFrame,0)
        for _, opt in ipairs(options) do
            local ob = New("TextButton", {Text=opt, Font=T.FONT, TextSize=T.FONT_SZ, TextColor3=opt==S[stateKey] and T.ACCENT2 or T.TEXT, BackgroundColor3=T.BG2, Size=UDim2.new(1,0,0,16), TextXAlignment=Enum.TextXAlignment.Left, ZIndex=21, Parent=menuFrame})
            Pad(ob,4)
            ob.MouseButton1Click:Connect(function()
                S[stateKey]=opt; btn.Text=opt
                if callback then callback(opt) end
                menuFrame:Destroy(); menuFrame=nil
            end)
        end
    end)
    return wrap
end

