local function New(cls, props, children)
    local obj = Instance.new(cls)
    for k, v in pairs(props) do pcall(function() obj[k] = v end) end
    if children then for _, c in ipairs(children) do if c then c.Parent = obj end end end
    return obj
end

local function Pad(parent, size)
    return New("UIPadding", {
        PaddingLeft=UDim.new(0,size), PaddingRight=UDim.new(0,size),
        PaddingTop=UDim.new(0,size),  PaddingBottom=UDim.new(0,size),
        Parent=parent,
    })
end

local function ListLayout(parent, spacing, dir)
    return New("UIListLayout", {
        SortOrder     = Enum.SortOrder.LayoutOrder,
        FillDirection = dir or Enum.FillDirection.Vertical,
        Padding       = UDim.new(0, spacing or 2),
        Parent        = parent,
    })
end

local function Corner(parent, r)
    New("UICorner", {CornerRadius=UDim.new(0, r or 2), Parent=parent})
end

local function Stroke(parent, color, thick)
    New("UIStroke", {Color=color or T.BORDER, Thickness=thick or 1, Parent=parent})
end

local function Label(parent, text, sz, col, xalign)
    return New("TextLabel", {
        Text=text, Font=T.FONT, TextSize=sz or T.FONT_SZ,
        TextColor3=col or T.TEXT, BackgroundTransparency=1,
        TextXAlignment=xalign or Enum.TextXAlignment.Left,
        AutomaticSize=Enum.AutomaticSize.XY, Parent=parent,
    })
end

local function ScrollFrame(parent, height)
    return New("ScrollingFrame", {
        Size=UDim2.new(1,0,0,height), BackgroundTransparency=1,
        ScrollBarThickness=2, ScrollBarImageColor3=T.ACCENT,
