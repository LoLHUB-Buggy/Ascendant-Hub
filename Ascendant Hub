local HLPool = {}

local function SetHighlight(player, char, color, fillAlpha, outAlpha)
    if not S.esp_highlight then
        if HLPool[player] then HLPool[player]:Destroy(); HLPool[player]=nil end
        return
    end
    if not HLPool[player] then
        local sb = Instance.new("SelectionBox")
        sb.LineThickness=0.04; sb.Adornee=char; sb.Parent=Camera
        HLPool[player] = sb
    end
    local sb = HLPool[player]
    sb.SurfaceColor3=color; sb.Color3=color
    sb.SurfaceTransparency=1-fillAlpha; sb.Transparency=1-outAlpha
    sb.Adornee=char
end

local function RemoveHighlight(player)
    if HLPool[player] then HLPool[player]:Destroy(); HLPool[player]=nil end
end

local function RenderESP()
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    local center    = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not S.esp_show_teammates and player.Team == LocalPlayer.Team then
            local d = DrawPool[player]; if d then HideD(d) end
            RemoveHighlight(player); continue
        end

        local d = GD(player)
        local root, hum, head = GetCharParts(player)

        if not root or not hum or hum.Health <= 0 or not S.esp_enabled then
            HideD(d); RemoveHighlight(player); continue
        end

        local dist = localRoot and Dist3(localRoot.Position, root.Position) or 0
        if dist > S.esp_max_dist then HideD(d); RemoveHighlight(player); continue end

        local state = localRoot and GetVisState(localRoot, root.Position, player.Character) or "Hidden"
        local col   = GetStateColor(state)
        local bb    = GetBB(player.Character)
        local onScreen = bb ~= nil

        -- Box
        if onScreen then
            d.box.Visible=true; d.box.Position=Vector2.new(bb.x,bb.y)
            d.box.Size=Vector2.new(bb.w,bb.h); d.box.Color=col
            d.box.Transparency=1-(S.esp_outline_opacity/100)
            d.boxFill.Visible=true; d.boxFill.Position=Vector2.new(bb.x,bb.y)
            d.boxFill.Size=Vector2.new(bb.w,bb.h); d.boxFill.Color=col
            d.boxFill.Transparency=1-(S.esp_fill_opacity/100)
        else d.box.Visible=false; d.boxFill.Visible=false end

        -- Highlight
        if onScreen then SetHighlight(player, player.Character, col, S.esp_fill_opacity/100, S.esp_outline_opacity/100)
        else RemoveHighlight(player) end

        -- Name
        if S.esp_names and onScreen then
            d.name.Visible=true; d.name.Text=player.DisplayName
            d.name.Position=Vector2.new(bb.mx, bb.ty-16); d.name.Color=col
        else d.name.Visible=false end

        -- Health text
        if S.esp_health and onScreen then
            local hp=math.floor(hum.Health); local mhp=math.floor(hum.MaxHealth)
            d.hpText.Visible=true; d.hpText.Text=string.format("%d/%d",hp,mhp)
            d.hpText.Position=Vector2.new(bb.mx, bb.by+(S.esp_distance and 14 or 2))
            d.hpText.Color=Color3.fromRGB(math.floor(255*(1-hp/mhp)),math.floor(255*(hp/mhp)),0)
        else d.hpText.Visible=false end

        -- Distance
        if S.esp_distance and onScreen then
            d.dist.Visible=true; d.dist.Text=string.format("%.0fm",dist)
            d.dist.Position=Vector2.new(bb.mx, bb.by+2)
        else d.dist.Visible=false end

        -- Weapon
        if S.esp_weapon and onScreen then
            d.weapon.Visible=true
            d.weapon.Text="["..GetWeaponName(player.Character).."]"
            local yOff = 2
            if S.esp_distance then yOff=yOff+12 end
            if S.esp_health   then yOff=yOff+12 end
            d.weapon.Position=Vector2.new(bb.mx, bb.by+yOff)
        else d.weapon.Visible=false end

        -- Vertical HP bar
        if S.esp_vert_hp and onScreen then
            local ratio=math.clamp(hum.Health/hum.MaxHealth,0,1)
            d.hpBack.Visible=true; d.hpBack.Position=Vector2.new(bb.x-6,bb.y); d.hpBack.Size=Vector2.new(3,bb.h)
            d.hpFill.Visible=true; d.hpFill.Position=Vector2.new(bb.x-6,bb.y+bb.h*(1-ratio)); d.hpFill.Size=Vector2.new(3,bb.h*ratio)
            d.hpFill.Color=Color3.fromRGB(math.floor(255*(1-ratio)),math.floor(255*ratio),0)
        else d.hpBack.Visible=false; d.hpFill.Visible=false end

        -- Look direction
        if S.esp_look_dir and head and onScreen then
            local s1,o1=W2S(head.Position); local s2,o2=W2S(head.Position+head.CFrame.LookVector*4)
            if o1 and o2 then d.lookDir.Visible=true; d.lookDir.From=s1; d.lookDir.To=s2; d.lookDir.Color=S.esp_col_lookdir
            else d.lookDir.Visible=false end
        else d.lookDir.Visible=false end

        -- Off-screen arrows
        if S.esp_arrows then
            local _, onSc = W2S(root.Position)
            if not onSc then
                local proj = Camera:WorldToScreenPoint(root.Position)
                local sp   = Vector2.new(proj.X, proj.Y)
                local arrowP, angle = GetArrowPos(sp)
                if arrowP and angle then
                    local sz=10
                    local tip=arrowP+Vector2.new(math.cos(angle),math.sin(angle))*sz
                    local lft=arrowP+Vector2.new(math.cos(angle+2.4),math.sin(angle+2.4))*sz*0.6
                    local rgt=arrowP+Vector2.new(math.cos(angle-2.4),math.sin(angle-2.4))*sz*0.6
                    d.arrow.Visible=true; d.arrow.PointA=tip; d.arrow.PointB=lft; d.arrow.PointC=rgt
                    d.arrow.Color=col; d.arrow.Transparency=1-(S.esp_outline_opacity/100)
                    d.arrowOut.Visible=true; d.arrowOut.PointA=tip; d.arrowOut.PointB=lft; d.arrowOut.PointC=rgt
                    d.arrowOut.Color=Color3.new()
                end
            else d.arrow.Visible=false; d.arrowOut.Visible=false end
        else d.arrow.Visible=false; d.arrowOut.Visible=false end
    end
end

