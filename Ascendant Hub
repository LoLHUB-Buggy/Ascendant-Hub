        btn.BackgroundColor3 = tname==name and T.TAB_ACTIVE or T.TAB_IDLE
        btn.TextColor3       = tname==name and T.TEXT or T.TEXT_DIM
    end
end

-- Tab buttons
for _, name in ipairs(tabDefs) do
    local btn = New("TextButton", {
        Text=name, Font=name==activeTab and Enum.Font.GothamBold or T.FONT,
        TextSize=T.FONT_SZ_SM,
        TextColor3=name==activeTab and T.TEXT or T.TEXT_DIM,
        BackgroundColor3=name==activeTab and T.TAB_ACTIVE or T.TAB_IDLE,
        Size=UDim2.new(0, math.floor(390/#tabDefs), 1, 0),
        Parent=TabBar,
    })
    tabBtns[name]=btn
    btn.MouseButton1Click:Connect(function() SwitchTab(name) end)
end

-- Drag
local dragging,dragStart,startPos=false,nil,nil
TitleBar.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=true; dragStart=i.Position; startPos=Window.Position
    end
end)
TitleBar.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
        local d=i.Position-dragStart
        Window.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
    end
end)

-- Toggle GUI
UserInputService.InputBegan:Connect(function(i,gp)
    if gp then return end
    if i.KeyCode==Enum.KeyCode.Insert then
        Window.Visible=not Window.Visible
    end
    if i.KeyCode==S.trig_key then
        S.trig_enabled=not S.trig_enabled
    end
end)

