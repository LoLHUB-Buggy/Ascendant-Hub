local function RenderThrowables()
    for obj, d in pairs(ThrowPool) do
        if not obj or not obj.Parent then
            for _, o in pairs(d) do if o.Remove then o:Remove() end end
            ThrowPool[obj]=nil
        end
    end
    if not S.esp_throwables or not S.esp_enabled then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            for _, tn in ipairs(THROWABLE_NAMES) do
                if obj.Name:lower():find(tn:lower()) then
