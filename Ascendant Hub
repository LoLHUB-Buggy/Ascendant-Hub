-- ============================================================
local lastCF = Camera.CFrame

local function PatchNoRecoil()
    RunService.RenderStepped:Connect(function()
        if not S.mod_no_recoil then lastCF=Camera.CFrame; return end
        local _,lastP,_ = lastCF:ToEulerAnglesYXZ()
        local _,curP,_  = Camera.CFrame:ToEulerAnglesYXZ()
        if curP - lastP < -0.003 then
            Camera.CFrame = lastCF
        else
            lastCF = Camera.CFrame
        end
    end)
end

local function ApplyToolMods(tool)
    if not tool then return end
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("NumberValue") then
            local n = v.Name:lower()
            if S.mod_attack_speed and (n:find("cooldown") or n:find("firerate") or n:find("delay")) then
                v.Value = v.Value * (100/S.mod_attack_pct)
            end
            if S.mod_fast_reload and (n:find("reload")) then
                v.Value = v.Value * (100/S.mod_reload_pct)
            end
            if S.mod_fast_ads and (n:find("ads") or n:find("aimtime")) then
                v.Value = v.Value * (100/S.mod_ads_pct)
            end
        end
    end
end

local function PatchWeaponMods()
    LocalPlayer.CharacterAdded:Connect(function(char)
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.05); ApplyToolMods(child) end
        end)
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then ApplyToolMods(v) end
        end
    end)
    if LocalPlayer.Character then
        for _, v in ipairs(LocalPlayer.Character:GetChildren()) do
            if v:IsA("Tool") then ApplyToolMods(v) end
        end
    end
end

local function RunSpeedAndAmmo()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and S.misc_speed then hum.WalkSpeed = S.misc_speed_val end
    if S.misc_inf_ammo then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            for _, v in ipairs(tool:GetDescendants()) do
                if v:IsA("NumberValue") then
                    local n = v.Name:lower()
                    if n:find("ammo") or n:find("mag") or n:find("bullet") then
                        v.Value = 9999
                    end
                end
            end
        end
    end
end

