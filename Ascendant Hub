local THROWABLE_NAMES = {"Grenade","FlashGrenade","SmokeGrenade","Molotov","Throwable","Bomb"}
local KATANA_NAMES    = {"Katana","Sword","Blade"}
local SHIELD_NAMES    = {"RiotShield","Shield"}
local BONES_PRIORITY  = {"Head","UpperTorso","LowerTorso","HumanoidRootPart","RightUpperArm","LeftUpperArm"}

local function W2S(pos)
    local s, on = Camera:WorldToViewportPoint(pos)
    if on then return Vector2.new(s.X, s.Y), true end
    return nil, false
end

local function Dist3(a, b) return (a - b).Magnitude end

local function GetCharParts(player)
    local c = player.Character
    if not c then return nil, nil, nil end
    return c:FindFirstChild("HumanoidRootPart"),
           c:FindFirstChildOfClass("Humanoid"),
           c:FindFirstChild("Head")
end

local function Raycast(origin, dir, extra)
    local params = RaycastParams.new()
    local ignore = {workspace.Terrain}
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
    if extra then for _, v in ipairs(extra) do table.insert(ignore, v) end end
    params.FilterDescendantsInstances = ignore
    params.FilterType = Enum.RaycastFilterType.Exclude
    return workspace:Raycast(origin, dir, params)
end

local function IsVisible(from, to, extra)
    return Raycast(from, to - from, extra) == nil
end

local function IsWallbangable(from, to)
    local hit = Raycast(from, to - from, nil)
    if not hit then return true end
    local offset = (to - from).Unit * (hit.Distance + 0.6)
    return Raycast(from + offset, to - (from + offset), nil) == nil
end

local function GetVisState(localRoot, targetPos, charIgnore)
    if IsVisible(localRoot.Position, targetPos, {charIgnore}) then
        return "Visible"
    elseif IsWallbangable(localRoot.Position, targetPos) then
        return "Wallbang"
    end
    return "Hidden"
end

local function GetStateColor(state)
    if state == "Visible"  then return S.esp_col_visible  end
    if state == "Wallbang" then return S.esp_col_wallbang end
    return S.esp_col_hidden
end

local function GetBB(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local top, onT = W2S(root.Position + Vector3.new(0,  3.2, 0))
    local bot, onB = W2S(root.Position - Vector3.new(0,  2.3, 0))
    if not onT or not onB then return nil end
    local h = math.abs(top.Y - bot.Y)
    local w = h * 0.45
    return { x=top.X-w/2, y=top.Y, w=w, h=h, mx=top.X, ty=top.Y, by=bot.Y }
end

local function GetWeaponName(char)
    local t = char:FindFirstChildOfClass("Tool")
    return t and t.Name or "None"
end

local function HoldsKatana(char)
    local w = GetWeaponName(char):lower()
    for _, n in ipairs(KATANA_NAMES) do if w:find(n:lower()) then return true end end
    return false
end

local function HoldsShield(char)
    local w = GetWeaponName(char):lower()
    for _, n in ipairs(SHIELD_NAMES) do if w:find(n:lower()) then return true end end
    return false
end

local function GetArrowPos(screenPos)
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local dir    = (screenPos - center)
    if dir.Magnitude == 0 then return nil, nil end
    local norm  = dir.Unit
    local angle = math.atan2(norm.Y, norm.X)
    return center + norm * S.esp_arrow_radius, angle
end

