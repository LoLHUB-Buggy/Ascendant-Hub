end

-- TOGGLE
local function MakeToggle(parent, labelText, stateKey, callback)
    local row = New("Frame", {BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.Y, Size=UDim2.new(1,0,0,0), Parent=parent})
    ListLayout(row, 0, Enum.FillDirection.Horizontal)
    local box = New("Frame", {Size=UDim2.new(0,10,0,10), BackgroundColor3=S[stateKey] and T.TOGGLE_ON or T.TOGGLE_OFF, Parent=row})
    Corner(box, 2); Stroke(box, T.BORDER)
    local dot = New("Frame", {Size=UDim2.new(0,5,0,5), Position=UDim2.new(0.5,-2,0.5,-2), BackgroundColor3=Color3.new(1,1,1), Visible=S[stateKey], Parent=box})
    Corner(dot, 1)
    local lbl = New("TextLabel", {Text=" "..labelText, Font=T.FONT, TextSize=T.FONT_SZ, TextColor3=S[stateKey] and T.TEXT or T.TEXT_DIM, BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Left, AutomaticSize=Enum.AutomaticSize.XY, Parent=row})
    local function Update()
        local on = S[stateKey]
        box.BackgroundColor3 = on and T.TOGGLE_ON or T.TOGGLE_OFF
        dot.Visible = on
        lbl.TextColor3 = on and T.TEXT or T.TEXT_DIM
    end
    row.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            S[stateKey] = not S[stateKey]; Update()
            if callback then callback(S[stateKey]) end
        end
    end)
    return row
end

-- SLIDER
local function MakeSlider(parent, labelText, stateKey, minV, maxV, suffix, callback)
    local wrap = New("Frame", {BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.Y, Size=UDim2.new(1,0,0,0), Parent=parent})
    ListLayout(wrap, 1)
    local topRow = New("Frame", {BackgroundTransparency=1, Size=UDim2.new(1,0,0,11), Parent=wrap})
    Label(topRow, labelText, T.FONT_SZ_SM, T.TEXT_DIM)
    local valLbl = New("TextLabel", {Text=tostring(S[stateKey])..(suffix or ""), Font=T.FONT, TextSize=T.FONT_SZ_SM, TextColor3=T.ACCENT2, BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Right, Size=UDim2.new(1,0,1,0), Parent=topRow})
    local track = New("Frame", {Size=UDim2.new(1,0,0,5), BackgroundColor3=T.SLIDER_BG, Parent=wrap})
    Corner(track, 2)
    local ratio0 = (S[stateKey] - minV) / math.max(maxV - minV, 1)
    local fill = New("Frame", {Size=UDim2.new(ratio0,0,1,0), BackgroundColor3=T.SLIDER_FILL, Parent=track})
    Corner(fill, 2)
    New("UIGradient", {Color=ColorSequence.new({ColorSequenceKeypoint.new(0,T.ACCENT), ColorSequenceKeypoint.new(1,T.ACCENT2)}), Parent=fill})
    local dragging = false
    local function SetValue(v)
        v = math.clamp(math.round(v), minV, maxV)
        S[stateKey] = v
        fill.Size = UDim2.new((v-minV)/math.max(maxV-minV,1),0,1,0)
        valLbl.Text = tostring(v)..(suffix or "")
        if callback then callback(v) end
    end
    track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    RunService.RenderStepped:Connect(function()
        if dragging then
            local rel = math.clamp((Mouse.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X,1), 0, 1)
            SetValue(minV + rel*(maxV-minV))
        end
    end)
    return wrap
end

