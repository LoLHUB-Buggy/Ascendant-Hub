-- ============================================================
local function PickBone(char, localRoot)
    if S.aim_target_part ~= "Auto" then
        return char:FindFirstChild(S.aim_target_part)
    end
    for _, boneName in ipairs(BONES_PRIORITY) do
        local bone = char:FindFirstChild(boneName)
        if bone then
            if not S.aim_visible_only then return bone end
            if IsVisible(localRoot.Position, bone.Position, {char}) then return bone end
        end
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function GetBestTarget()
    local center    = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local bestDist  = S.aim_ignore_fov and math.huge or S.aim_fov_radius
    local bestBone  = nil
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not S.esp_teammates and player.Team == LocalPlayer.Team then continue end
        local root, hum, _ = GetCharParts(player)
        if not root or not hum or hum.Health <= 0 then continue end

        if S.aim_block_katana  and HoldsKatana(player.Character)  then continue end
        if S.aim_block_shield  and HoldsShield(player.Character)  then
            local toTarget = (root.Position - localRoot.Position).Unit
            local face = player.Character:FindFirstChild("HumanoidRootPart")
            if face and toTarget:Dot(face.CFrame.LookVector) < -0.5 then continue end
        end

        if not S.aim_wallbang and S.aim_visible_only then
            if not IsVisible(localRoot.Position, root.Position, {player.Character}) then
                if not IsWallbangable(localRoot.Position, root.Position) then continue end
            end
        end

        local bone = PickBone(player.Character, localRoot)
        if not bone then continue end
        local sPos, onScreen = W2S(bone.Position)
        if not onScreen then continue end
        local d = (sPos - center).Magnitude
        if d < bestDist then bestDist=d; bestBone=bone end
    end
    return bestBone
end

local function RunAimbot()
    if not S.aim_enabled then return end
    local pressing = UserInputService:IsMouseButtonPressed(S.aim_key)
    if not pressing then return end
    local bone = GetBestTarget()
    if not bone then return end
    local smooth = 1 - (S.aim_smooth / 100)
    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, bone.Position), smooth)
end

local function UpdateFovCircle()
    FovCircle.Visible  = S.vis_fov_circle and S.aim_enabled
    FovCircle.Radius   = S.aim_fov_radius
    FovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
end

