-- Helper to make mobile buttons / toggles
local function createMobileToggle(name, configKey, yPos)
    local btn = Instance.new("TextButton", ScrollContainer)
    btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(85, 65, 140) or Color3.fromRGB(22, 18, 32)
    btn.BorderColor3 = Color3.fromRGB(65, 45, 95)
    btn.Position = UDim2.new(0, 5, 0, yPos)
    btn.Size = UDim2.new(0, 16, 0, 16)
    btn.Text = ""

    local lbl = Instance.new("TextLabel", ScrollContainer)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 28, 0, yPos - 2)
    lbl.Size = UDim2.new(0, 250, 0, 20)
    lbl.Font = Enum.Font.SourceSansBold
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(210, 200, 230)
    lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(85, 65, 140) or Color3.fromRGB(22, 18, 32)
        if configKey == "UIHidden" then
            MainFrame.Visible = not Config.UIHidden
        end
    end)
end

-- Helper for mobile sliders (Orbit Adjustments)
local function createMobileSlider(name, configKey, min, max, yPos)
    local lbl = Instance.new("TextLabel", ScrollContainer)
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 5, 0, yPos)
    lbl.Size = UDim2.new(1, -10, 0, 16)
    lbl.Font = Enum.Font.SourceSans
    lbl.Text = name .. ": " .. tostring(Config[configKey])
    lbl.TextColor3 = Color3.fromRGB(200, 190, 220)
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local bar = Instance.new("Frame", ScrollContainer)
    bar.BackgroundColor3 = Color3.fromRGB(22, 18, 32)
    bar.BorderColor3 = Color3.fromRGB(65, 45, 95)
    bar.Position = UDim2.new(0, 5, 0, yPos + 18)
    bar.Size = UDim2.new(1, -20, 0, 16)

    local fill = Instance.new("Frame", bar)
    fill.BackgroundColor3 = Color3.fromRGB(85, 65, 140)
    fill.BorderSizePixel = 0
    local initialPos = math.clamp((Config[configKey] - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(initialPos, 0, 1, 0)

    local draggingSlider = false
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local absoluteSizeX = bar.AbsoluteSize.X
            if absoluteSizeX > 0 then
                local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / absoluteSizeX, 0, 1)
                Config[configKey] = math.floor(min + (max - min) * pos)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                lbl.Text = name .. ": " .. tostring(Config[configKey])
            end
        end
    end)
end

