-- Desync (fixed — Y=0, persistent offset, 120ms refresh)
local desyncOffset=Vector3.new(0,0,0)
local desyncClock=0
RunService.Heartbeat:Connect(function(dt)
    local char=LocalPlayer.Character; if not char then return end
    local root=char:FindFirstChild("HumanoidRootPart"); if not root then return end
    if Config.Desync then
        desyncClock=desyncClock+dt
        if desyncClock>=0.12 then
            desyncOffset=Vector3.new(math.random(-10,10),0,math.random(-10,10))
            desyncClock=0
        end
        pcall(function() root.CFrame=root.CFrame+desyncOffset end)
    else
        desyncOffset=Vector3.new(0,0,0); desyncClock=0
    end
end)

-- RenderStepped: weapons + movement
RunService.RenderStepped:Connect(function()
    local char=LocalPlayer.Character; if not char then return end
    local root=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")

    -- weapon patches
    if Config.RapidFire or Config.RapidMelee or Config.NoRecoil or Config.NoSpread then
        pcall(function()
            for _,tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    for _,v in ipairs(tool:GetDescendants()) do
                        if v:IsA("NumberValue") or v:IsA("IntValue") then
                            local n=v.Name:lower()
                            if Config.RapidFire   and (n:find("cooldown") or n:find("rate") or n:find("firerate")) then v.Value=0.01 end
                            if Config.RapidMelee  and (n:find("cooldown") or n:find("delay") or n:find("speed"))   then v.Value=0.01 end
                            if Config.NoRecoil    and (n:find("recoil")   or n:find("kick"))                       then v.Value=0    end
                            if Config.NoSpread    and (n:find("spread")   or n:find("accuracy") or n:find("inaccuracy")) then v.Value=0 end
                        end
                    end
                end
            end
        end)
    end

    -- fly
    if Config.Fly and hum and root then
        hum.PlatformStand=true
        local md=hum.MoveDirection
        root.AssemblyLinearVelocity=Vector3.new(md.X*Config.FlySpeed,0,md.Z*Config.FlySpeed)
    elseif hum and hum.PlatformStand and not Config.Fly then
        hum.PlatformStand=false
    end

    -- speed
    if Config.SpeedHack and hum then hum.WalkSpeed=Config.WalkSpeed end

    -- noclip
    if Config.Noclip then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=false end
        end
    end

    -- fullbright
    if Config.FullBright then
        pcall(function()
            local L=game:GetService("Lighting")
            L.Brightness=2; L.ClockTime=14
            L.FogEnd=100000; L.GlobalShadows=false
            L.Ambient=Color3.new(1,1,1)
        end)
    end
end)

