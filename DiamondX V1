local sDrag, sDragStart, sSideStart
Sidebar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        sDrag=true; sDragStart=i.Position; sSideStart=Sidebar.Position
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then sDrag=false end
        end)
    end
