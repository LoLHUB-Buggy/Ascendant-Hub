-- Slider — global touch drag, finger can leave track
local function Slider(parent, label, configKey, minV, maxV, y)
    local TRACK_W = parent.Size.X.Offset - 20
    if TRACK_W <= 0 then TRACK_W = COL_W - 20 end
    local TRACK_H = IS_MOBILE and 22 or 14

    local lbl=Instance.new("TextLabel",parent)
    lbl.BackgroundTransparency=1
    lbl.Position=UDim2.new(0,10,0,y)
    lbl.Size=UDim2.new(0,TRACK_W,0,18)
    lbl.Font=Enum.Font.SourceSans
    lbl.Text=label..": "..tostring(Config[configKey])
    lbl.TextColor3=C.textMain; lbl.TextSize=FSZ_SM
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.ZIndex=9

    local track=Instance.new("Frame",parent)
    track.BackgroundColor3=C.sliderBg
    track.BorderColor3=C.border; track.BorderSizePixel=1
    track.Position=UDim2.new(0,10,0,y+20)
    track.Size=UDim2.new(0,TRACK_W,0,TRACK_H); track.ZIndex=9

    local fill=Instance.new("Frame",track)
    fill.BackgroundColor3=C.sliderFill; fill.BorderSizePixel=0
    fill.Size=UDim2.new((Config[configKey]-minV)/(maxV-minV),0,1,0); fill.ZIndex=10

    -- value label centered on slider  (matches screenshot "1000/1000" style)
    local valLbl=Instance.new("TextLabel",track)
    valLbl.BackgroundTransparency=1; valLbl.Size=UDim2.new(1,0,1,0)
    valLbl.Font=Enum.Font.SourceSansBold
    valLbl.Text=tostring(Config[configKey]).."/"..tostring(maxV)
    valLbl.TextColor3=Color3.new(1,1,1); valLbl.TextSize=FSZ_SM; valLbl.ZIndex=11

    local thumb=Instance.new("Frame",track)
    thumb.BackgroundColor3=Color3.new(1,1,1); thumb.BorderSizePixel=0
    thumb.AnchorPoint=Vector2.new(0.5,0.5)
    thumb.Size=UDim2.new(0,IS_MOBILE and 18 or 10,0,IS_MOBILE and 18 or 10)
    thumb.Position=UDim2.new((Config[configKey]-minV)/(maxV-minV),0,0.5,0)
    thumb.ZIndex=12
    local tc=Instance.new("UICorner",thumb); tc.CornerRadius=UDim.new(1,0)

    local sliding=false
    local function applyX(sx)
        local rel=math.clamp((sx-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local val=math.floor(rel*(maxV-minV)+minV+0.5)
        Config[configKey]=val
        fill.Size=UDim2.new(rel,0,1,0)
        thumb.Position=UDim2.new(rel,0,0.5,0)
        lbl.Text=label..": "..tostring(val)
        valLbl.Text=tostring(val).."/"..tostring(maxV)
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            sliding=true; applyX(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not sliding then return end
        if i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch then applyX(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then sliding=false end
    end)
end

-- Dropdown  — touch-friendly, opens a list below
local openDropdown = nil   -- track which is open so others auto-close

local function Dropdown(parent, label, configKey, options, y)
    local DROP_H = TAP_H
    local ITEM_H = TAP_H

    -- label above
    local hdr=Instance.new("TextLabel",parent)
    hdr.BackgroundTransparency=1
    hdr.Position=UDim2.new(0,10,0,y)
    hdr.Size=UDim2.new(1,-14,0,18)
    hdr.Font=Enum.Font.SourceSansBold; hdr.Text=label
    hdr.TextColor3=C.textHeader; hdr.TextSize=FSZ_LG
    hdr.TextXAlignment=Enum.TextXAlignment.Left; hdr.ZIndex=9

    -- selected value bar
    local bar=Instance.new("TextButton",parent)
    bar.BackgroundColor3=C.dropBg
    bar.BorderColor3=C.border; bar.BorderSizePixel=1
    bar.Position=UDim2.new(0,10,0,y+22)
    bar.Size=UDim2.new(1,-20,0,DROP_H)
    bar.Font=Enum.Font.SourceSans
    bar.Text="  "..Config[configKey]
    bar.TextColor3=C.textMain; bar.TextSize=FSZ_LG
    bar.TextXAlignment=Enum.TextXAlignment.Left; bar.ZIndex=9

    -- arrow indicator
    local arrow=Instance.new("TextLabel",bar)
    arrow.BackgroundTransparency=1
    arrow.Position=UDim2.new(1,-28,0,0)
    arrow.Size=UDim2.new(0,24,1,0)
    arrow.Font=Enum.Font.SourceSansBold; arrow.Text="▼"
    arrow.TextColor3=C.textMain; arrow.TextSize=FSZ_SM; arrow.ZIndex=10

    -- dropdown list frame (hidden by default)
    local listFrame=Instance.new("Frame",parent)
    listFrame.BackgroundColor3=C.dropBg
    listFrame.BorderColor3=C.border; listFrame.BorderSizePixel=1
    listFrame.Position=UDim2.new(0,10,0,y+22+DROP_H)
    listFrame.Size=UDim2.new(1,-20,0,#options*ITEM_H)
    listFrame.Visible=false; listFrame.ZIndex=50   -- high Z so it floats over content

    for idx,opt in ipairs(options) do
        local item=Instance.new("TextButton",listFrame)
        item.BackgroundColor3=C.dropBg
        item.BorderColor3=C.border; item.BorderSizePixel=1
        item.Position=UDim2.new(0,0,0,(idx-1)*ITEM_H)
        item.Size=UDim2.new(1,0,0,ITEM_H)
        item.Font=Enum.Font.SourceSans
        item.Text="  "..opt
        item.TextColor3=C.textMain; item.TextSize=FSZ_LG
        item.TextXAlignment=Enum.TextXAlignment.Left; item.ZIndex=51

        item.MouseButton1Click:Connect(function()
            Config[configKey]=opt
            bar.Text="  "..opt
            listFrame.Visible=false
            arrow.Text="▼"
            openDropdown=nil
        end)
    end

    bar.MouseButton1Click:Connect(function()
        if openDropdown and openDropdown~=listFrame then
            openDropdown.Visible=false
        end
        listFrame.Visible=not listFrame.Visible
        arrow.Text=listFrame.Visible and "▲" or "▼"
        openDropdown=listFrame.Visible and listFrame or nil
    end)

    return y + 22 + DROP_H + 8   -- returns next y position
end

