-- Helper: Create Toggle inside Group Box
local function createToggle(parent, name, configKey, yPos)
    local state = Config[configKey]
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = state and Color3.fromRGB(85, 65, 140) or Color3.fromRGB(22, 18, 32)
    btn.BorderColor3 = Color3.fromRGB(65, 45, 95)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.Size = UDim2.new(0, 13, 0, 13)
    btn.Text = ""

    local lbl = Instance.new("TextLabel")
    lbl.Parent = parent
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 30, 0, yPos - 4)
    lbl.Size = UDim2.new(0, 200, 0, 20)
    lbl.Font = Enum.Font.SourceSans
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(200, 190, 220)
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(85, 65, 140) or Color3.fromRGB(22, 18, 32)
    end)
end

-- Helper: Create Slider with Safe Dragging Boundaries
local function createSlider(parent, name, configKey, min, max, yPos)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = parent
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, yPos)
    lbl.Size = UDim2.new(1, -20, 0, 15)
    lbl.Font = Enum.Font.SourceSans
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(200, 190, 220)
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local bar = Instance.new("Frame")
    bar.Parent = parent
    bar.BackgroundColor3 = Color3.fromRGB(22, 18, 32)
    bar.BorderColor3 = Color3.fromRGB(65, 45, 95)
    bar.Position = UDim2.new(0, 10, 0, yPos + 16)
    bar.Size = UDim2.new(0, 235, 0, 14)

    local fill = Instance.new("Frame")
    fill.Parent = bar
    fill.BackgroundColor3 = Color3.fromRGB(85, 65, 140)
    fill.BorderSizePixel = 0
    local initialPos = math.clamp((Config[configKey] - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(initialPos, 0, 1, 0)

    local valLbl = Instance.new("TextLabel")
    valLbl.Parent = bar
    valLbl.BackgroundTransparency = 1
    valLbl.Size = UDim2.new(1, 0, 1, 0)
    valLbl.Font = Enum.Font.SourceSans
    valLbl.Text = tostring(Config[configKey]) .. "/" .. tostring(max)
    valLbl.TextColor3 = Color3.fromRGB(220, 210, 240)
    valLbl.TextSize = 11

    local draggingSlider = false
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local absoluteSizeX = bar.AbsoluteSize.X
            if absoluteSizeX > 0 then
                local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / absoluteSizeX, 0, 1)
                Config[configKey] = math.floor(min + (max - min) * pos)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                valLbl.Text = tostring(Config[configKey]) .. "/" .. tostring(max)
            end
        end
    end)
end

