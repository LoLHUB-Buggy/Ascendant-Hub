-- ==================== SAFE RUNTIME LOGIC ====================

local function GetBestTarget()
    local target = nil
    local shortestDist = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetPart = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if targetPart and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        target = targetPart
                    end
                end
            end
        end
    end
    return target
end

-- Core Execution Loop with Safe Guardrails
RunService.RenderStepped:Connect(function()
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    -- Ragebot Orbit & Target Lock Feature
    if Config.RagebotEnable and Config.Orbit then
        local targetPart = GetBestTarget()
        if targetPart then
            local targetPos = targetPart.Position + Vector3.new(0, 2, 0)
            rootPart.CFrame = CFrame.new(targetPos, targetPart.Position)
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end
    
    -- Desync (Beta) Feature Logic with error handling
    if Config.RagebotEnable and Config.Desync then
        local originalCFrame = rootPart.CFrame
        if math.sin(tick() * 10) > 0 then
            pcall(function()
                rootPart.CFrame = originalCFrame + Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
                RunService.RenderStepped:Wait()
                rootPart.CFrame = originalCFrame
            end)
        end
    end
    
    -- Noclip implementation
    if Config.Noclip then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

