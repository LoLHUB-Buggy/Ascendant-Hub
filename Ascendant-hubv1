    local pill=N("Frame",{
        Size=UDim2.new(0,46,0,22),
        Position=UDim2.new(1,-54,0.5,-11),
        BackgroundColor3=S[key] and T.TON or T.TOFF,
        Parent=row,
    })
    Corn(pill,11)

    local knob=N("Frame",{
        Size=UDim2.new(0,18,0,18),
        Position=UDim2.new(S[key] and 1 or 0,S[key] and -21 or 3,0.5,-9),
        BackgroundColor3=Color3.new(1,1,1),
        Parent=pill,
    })
    Corn(knob,9)

    local function Upd()
        local on=S[key]
        bar.BackgroundColor3=on and T.TON or T.TOFF
        pill.BackgroundColor3=on and T.TON or T.TOFF
        knob.Position=UDim2.new(on and 1 or 0,on and -21 or 3,0.5,-9)
        local lbl=row:FindFirstChildOfClass("TextLabel")
        if lbl then lbl.TextColor3=on and T.TEXT or T.DIM end
    end

    -- tap anywhere on the row
    row.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            S[key]=not S[key]; Upd()
            if cb then cb(S[key]) end
        end
    end)
    return row
end

-- ── MOBILE SLIDER ─────────────────────────────────────────────
local function MakeSli(parent,label,key,mn,mx,suf,cb)
    local wrap=N("Frame",{
        BackgroundColor3=T.BG3,
        AutomaticSize=Enum.AutomaticSize.Y,
        Size=UDim2.new(1,0,0,0),
        Parent=parent,
    })
    Corn(wrap,T.CORNER)
    Pad(wrap,T.PAD)
    LL(wrap,4)

    -- top row: label + value
    local top=N("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,T.FSZ+2),Parent=wrap})
    Txt(top,label,T.FSZ,T.DIM)
    local vl=N("TextLabel",{
        Text=tostring(S[key])..(suf or ""),Font=T.FONT,TextSize=T.FSZ,
        TextColor3=T.ACCENT2,BackgroundTransparency=1,
        TextXAlignment=Enum.TextXAlignment.Right,
        Size=UDim2.new(1,0,1,0),Parent=top,
    })

    -- track (tall for finger)
    local track=N("Frame",{Size=UDim2.new(1,0,0,10),BackgroundColor3=T.SBG,Parent=wrap})
    Corn(track,5)
    local r0=(S[key]-mn)/math.max(mx-mn,1)
    local fill=N("Frame",{Size=UDim2.new(r0,0,1,0),BackgroundColor3=T.ACCENT,Parent=track})
    Corn(fill,5)
    N("UIGradient",{Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,T.ACCENT),
        ColorSequenceKeypoint.new(1,T.ACCENT2),
    }),Parent=fill})

    -- thumb
    local thumb=N("Frame",{
        Size=UDim2.new(0,22,0,22),
        Position=UDim2.new(r0,r0>0 and -11 or 0,0.5,-11),
        BackgroundColor3=T.ACCENT2,
        Parent=track,
    })
    Corn(thumb,11)
    Strk(thumb,T.BG,2)

    local drag=false

    local function Set(x)
        local rel=math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
        local v=math.clamp(math.round(mn+rel*(mx-mn)),mn,mx)
        S[key]=v
        fill.Size=UDim2.new(rel,0,1,0)
        thumb.Position=UDim2.new(rel,rel>0 and -11 or 0,0.5,-11)
        vl.Text=tostring(v)..(suf or "")
        if cb then cb(v) end
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            drag=true; Set(i.Position.X)
        end
    end)
    track.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch) then
            Set(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then drag=false end
    end)
    return wrap
end

