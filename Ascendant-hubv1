        BackgroundColor3=T.BG3,
        Size=UDim2.new(1,0,0,T.ROW),
        Parent=parent,
    })
    Corn(row,T.CORNER)

    -- left colored bar when ON
    local bar=N("Frame",{
        Size=UDim2.new(0,3,1,0),
        BackgroundColor3=S[key] and T.TON or T.TOFF,
        Parent=row,
    })
    Corn(bar,2)

    -- label
    N("TextLabel",{
        Text=label,Font=T.FONT,TextSize=T.FSZ,
        TextColor3=S[key] and T.TEXT or T.DIM,
        BackgroundTransparency=1,
        TextXAlignment=Enum.TextXAlignment.Left,
        Position=UDim2.new(0,12,0,0),
        Size=UDim2.new(0.75,0,1,0),
        Parent=row,
    })

