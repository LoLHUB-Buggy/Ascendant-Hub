end
local function GD(pl)
    if DP[pl] then return DP[pl] end
    DP[pl]={
        box    =ND("Square",  {Visible=false,Filled=false,Thickness=1}),
        bfill  =ND("Square",  {Visible=false,Filled=true}),
        name   =ND("Text",    {Visible=false,Size=14,Center=true,Outline=true,OutlineColor=Color3.new()}),
        hptxt  =ND("Text",    {Visible=false,Size=12,Center=true,Outline=true,OutlineColor=Color3.new()}),
        dist   =ND("Text",    {Visible=false,Size=12,Center=true,Outline=true,OutlineColor=Color3.new(),Color=Color3.fromRGB(200,200,200)}),
        wep    =ND("Text",    {Visible=false,Size=12,Center=true,Outline=true,OutlineColor=Color3.new(),Color=Color3.fromRGB(255,220,100)}),
        hpbk   =ND("Square",  {Visible=false,Filled=true,Color=Color3.fromRGB(20,20,20)}),
        hpfl   =ND("Square",  {Visible=false,Filled=true}),
        lkdir  =ND("Line",    {Visible=false,Thickness=1}),
        arr    =ND("Triangle",{Visible=false,Filled=true}),
        arrout =ND("Triangle",{Visible=false,Filled=false,Thickness=1}),
    }
    return DP[pl]
end
local function HideD(d) for _,o in pairs(d) do if o and o.Visible~=nil then o.Visible=false end end end
local function KillD(pl)
    local d=DP[pl]; if not d then return end
    for _,o in pairs(d) do if o and o.Remove then o:Remove() end end
    DP[pl]=nil
end
local FOV=ND("Circle",{Visible=false,Filled=false,Thickness=1,Radius=120,
