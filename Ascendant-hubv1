        FillDirection=dir or Enum.FillDirection.Vertical,
        Padding=UDim.new(0,sp or 4),Parent=p})
end
local function Corn(p,r) N("UICorner",{CornerRadius=UDim.new(0,r or T.CORNER),Parent=p}) end
local function Strk(p,c,th) N("UIStroke",{Color=c or T.BORDER,Thickness=th or 1,Parent=p}) end
