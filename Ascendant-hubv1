    for k,v in pairs(props) do pcall(function() o[k]=v end) end
    return o
end
local function Pad(p,s)
    N("UIPadding",{PaddingLeft=UDim.new(0,s),PaddingRight=UDim.new(0,s),
        PaddingTop=UDim.new(0,s),PaddingBottom=UDim.new(0,s),Parent=p})
end
