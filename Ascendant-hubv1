    Position=Vector2.new(VP().X/2,VP().Y/2)})

-- ============================================================
--  [7] ESP  (12fps throttle)
-- ============================================================
local ET=0; local ER=1/12
local function RenderESP()
    local now=tick(); if now-ET<ER then return end; ET=now
    local lc=LocalPlayer.Character
    local lr=lc and lc:FindFirstChild("HumanoidRootPart")
    local ft=1-(S.esp_fill_opacity/100)
    local ot=1-(S.esp_outline_opacity/100)

    for _,pl in ipairs(Players:GetPlayers()) do
        if pl==LocalPlayer then continue end
        if not S.esp_teammates and pl.Team==LocalPlayer.Team then
            local d=DP[pl]; if d then HideD(d) end; continue
        end
        local d=GD(pl)
        local root,hum,head=GCP(pl)
        if not root or not hum or hum.Health<=0 or not S.esp_enabled then HideD(d); continue end
        local dist=lr and D3(lr.Position,root.Position) or 0
        if dist>S.esp_max_dist then HideD(d); continue end

        local col=lr and StateCol(lr,root.Position) or S.esp_col_visible
        local bb=GetBB(pl.Character)
        local on=bb~=nil

        -- box
        if on then
            d.box.Visible=true; d.box.Position=Vector2.new(bb.x,bb.y)
            d.box.Size=Vector2.new(bb.w,bb.h); d.box.Color=col; d.box.Transparency=ot
            d.bfill.Visible=true; d.bfill.Position=Vector2.new(bb.x,bb.y)
            d.bfill.Size=Vector2.new(bb.w,bb.h); d.bfill.Color=col; d.bfill.Transparency=ft
        else d.box.Visible=false; d.bfill.Visible=false end

        -- name
        if S.esp_names and on then
            d.name.Visible=true; d.name.Text=pl.DisplayName
            d.name.Position=Vector2.new(bb.mx,bb.ty-18); d.name.Color=col
        else d.name.Visible=false end

        -- hp text
        if S.esp_health and on then
            local hp=math.floor(hum.Health); local mhp=math.floor(hum.MaxHealth)
            local r=hp/mhp
            d.hptxt.Visible=true; d.hptxt.Text=hp.."/"..mhp
            d.hptxt.Position=Vector2.new(bb.mx,bb.by+(S.esp_distance and 14 or 2))
            d.hptxt.Color=Color3.fromRGB(math.floor(255*(1-r)),math.floor(255*r),0)
        else d.hptxt.Visible=false end

        -- dist
        if S.esp_distance and on then
            d.dist.Visible=true; d.dist.Text=math.floor(dist).."m"
            d.dist.Position=Vector2.new(bb.mx,bb.by+2)
        else d.dist.Visible=false end

        -- weapon
        if S.esp_weapon and on then
            d.wep.Visible=true; d.wep.Text="["..GWep(pl.Character).."]"
            local yo=2
            if S.esp_distance then yo=yo+12 end
            if S.esp_health then yo=yo+12 end
            d.wep.Position=Vector2.new(bb.mx,bb.by+yo)
        else d.wep.Visible=false end

        -- vert hp bar
        if S.esp_vert_hp and on then
            local ratio=math.clamp(hum.Health/hum.MaxHealth,0,1)
            d.hpbk.Visible=true; d.hpbk.Position=Vector2.new(bb.x-7,bb.y); d.hpbk.Size=Vector2.new(4,bb.h)
            d.hpfl.Visible=true
            d.hpfl.Position=Vector2.new(bb.x-7,bb.y+bb.h*(1-ratio))
            d.hpfl.Size=Vector2.new(4,bb.h*ratio)
            d.hpfl.Color=Color3.fromRGB(math.floor(255*(1-ratio)),math.floor(255*ratio),0)
        else d.hpbk.Visible=false; d.hpfl.Visible=false end

        -- look dir
        if S.esp_look_dir and head and on then
            local s1,o1=W2S(head.Position)
            local s2,o2=W2S(head.Position+head.CFrame.LookVector*4)
            if o1 and o2 then d.lkdir.Visible=true; d.lkdir.From=s1; d.lkdir.To=s2; d.lkdir.Color=S.esp_col_lookdir
            else d.lkdir.Visible=false end
        else d.lkdir.Visible=false end

        -- arrows
        if S.esp_arrows then
            local _,onsc=W2S(root.Position)
            if not onsc then
                local p3=Camera:WorldToScreenPoint(root.Position)
                local ap,ang=ArrowPos(Vector2.new(p3.X,p3.Y))
                if ap and ang then
                    local sz=12
                    local tip=ap+Vector2.new(math.cos(ang),math.sin(ang))*sz
                    local lf =ap+Vector2.new(math.cos(ang+2.4),math.sin(ang+2.4))*sz*0.6
                    local rg =ap+Vector2.new(math.cos(ang-2.4),math.sin(ang-2.4))*sz*0.6
                    d.arr.Visible=true; d.arr.PointA=tip; d.arr.PointB=lf; d.arr.PointC=rg
                    d.arr.Color=col; d.arr.Transparency=ot
                    d.arrout.Visible=true; d.arrout.PointA=tip; d.arrout.PointB=lf; d.arrout.PointC=rg
                    d.arrout.Color=Color3.new()
                end
            else d.arr.Visible=false; d.arrout.Visible=false end
        else d.arr.Visible=false; d.arrout.Visible=false end
    end
end

-- ============================================================
--  [8] AIMBOT
-- ============================================================
local function PickBone(char,lr)
    if S.aim_target_part~="Auto" then return char:FindFirstChild(S.aim_target_part) end
    for _,n in ipairs(BONES) do
        local b=char:FindFirstChild(n)
        if b then
            if not S.aim_visible_only then return b end
            if Vis(lr.Position,b.Position) then return b end
        end
    end
    return char:FindFirstChild("Head")
end

local function BestTarget()
    local c=Vector2.new(VP().X/2,VP().Y/2)
    local bd=S.aim_ignore_fov and math.huge or S.aim_fov_radius
    local bb=nil
    local lc=LocalPlayer.Character
    local lr=lc and lc:FindFirstChild("HumanoidRootPart")
    if not lr then return nil end
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl==LocalPlayer then continue end
        if not S.esp_teammates and pl.Team==LocalPlayer.Team then continue end
        local root,hum,_=GCP(pl)
        if not root or not hum or hum.Health<=0 then continue end
        if S.aim_block_katana and HasItem(pl.Character,KATANAS) then continue end
        if S.aim_block_shield and HasItem(pl.Character,SHIELDS) then
            local f=pl.Character:FindFirstChild("HumanoidRootPart")
            if f and ((root.Position-lr.Position).Unit):Dot(f.CFrame.LookVector)<-0.5 then continue end
        end
        if not S.aim_wallbang and S.aim_visible_only then
            if not Vis(lr.Position,root.Position) then continue end
        end
        local bone=PickBone(pl.Character,lr)
        if not bone then continue end
        local sp,on=W2S(bone.Position)
        if not on then continue end
        local d=(sp-c).Magnitude
        if d<bd then bd=d; bb=bone end
    end
    return bb
end

local function RunAim()
    if not S.aim_enabled then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    local bone=BestTarget()
    if not bone then return end
    Camera.CFrame=Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position,bone.Position),1-(S.aim_smooth/100))
end

local function UpdFov()
    FOV.Visible=S.vis_fov_circle and S.aim_enabled
    FOV.Radius=S.aim_fov_radius
    FOV.Position=Vector2.new(VP().X/2,VP().Y/2)
end

-- ============================================================
--  [9] TRIGGERBOT
-- ============================================================
local function RunTrig()
    if not S.trig_enabled then return end
    -- support both key and mouse button for triggerbot
    local keyHeld = pcall(function()
        return UserInputService:IsKeyDown(S.trig_key)
    end) and UserInputService:IsKeyDown(S.trig_key)
    -- on mobile trig fires without key check if enabled
    if not IsMobile and not keyHeld then return end
    local c=Vector2.new(VP().X/2,VP().Y/2)
    local lc=LocalPlayer.Character; local lr=lc and lc:FindFirstChild("HumanoidRootPart")
    if not lr then return end
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl==LocalPlayer then continue end
        local root,hum,_=GCP(pl)
        if not root or not hum or hum.Health<=0 then continue end
        local bone=PickBone(pl.Character,lr)
        if not bone then continue end
        local sp,on=W2S(bone.Position)
        if on and (sp-c).Magnitude<S.trig_fov then pcall(mouse1click); return end
    end
end

-- ============================================================
--  [9b] PROJECTILE REDIRECT
-- ============================================================
local THROW_REDIR_TICK=0
local function RunProjRedirect()
    if not S.proj_redirect then return end
    local now=tick(); if now-THROW_REDIR_TICK<0.05 then return end
    THROW_REDIR_TICK=now
    local lc=LocalPlayer.Character
    local lr=lc and lc:FindFirstChild("HumanoidRootPart")
    if not lr then return end
    -- find closest enemy
    local bestDist=math.huge; local bestPos=nil
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl==LocalPlayer then continue end
        local root,hum,_=GCP(pl)
        if not root or not hum or hum.Health<=0 then continue end
        local d=D3(lr.Position,root.Position)
        if d<bestDist then bestDist=d; bestPos=root.Position end
    end
    if not bestPos then return end
    -- steer any moving throwables
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            for _,tn in ipairs(THROWNS) do
                if obj.Name:lower():find(tn:lower()) then
                    if obj.AssemblyLinearVelocity.Magnitude>2 then
                        local dir=(bestPos-obj.Position).Unit
                        local spd=obj.AssemblyLinearVelocity.Magnitude
                        pcall(function() obj.AssemblyLinearVelocity=dir*spd end)
                    end
                    break
                end
            end
        end
    end
end

-- ============================================================
--  [9c] ESP HIGHLIGHT (SelectionBox — off by default, mobile expensive)
-- ============================================================
local HLPool={}
local HL_TICK=0; local HL_RATE=1/6  -- 6fps, even slower than ESP

local function RunHighlight()
    if not S.esp_highlight then
        for pl,sb in pairs(HLPool) do sb:Destroy(); HLPool[pl]=nil end
        return
    end
    local now=tick(); if now-HL_TICK<HL_RATE then return end
    HL_TICK=now
    local ft=1-(S.esp_fill_opacity/100)
    local ot=1-(S.esp_outline_opacity/100)
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl==LocalPlayer then continue end
        local char=pl.Character
        local _,hum,_=GCP(pl)
        if not char or not hum or hum.Health<=0 or not S.esp_enabled then
            if HLPool[pl] then HLPool[pl]:Destroy(); HLPool[pl]=nil end
            continue
        end
        local col=S.esp_col_visible
        if not HLPool[pl] then
            local sb=Instance.new("SelectionBox")
            sb.LineThickness=0.04; sb.Parent=Camera
            HLPool[pl]=sb
        end
        local sb=HLPool[pl]
        sb.SurfaceColor3=col; sb.Color3=col
        sb.SurfaceTransparency=1-ft; sb.Transparency=1-ot
        sb.Adornee=char
    end
end

-- ============================================================
--  [10] MODS
-- ============================================================
local lastCF=Camera.CFrame
local MT=0; local MR=1/10

local function NoRec()
    if not S.mod_no_recoil then lastCF=Camera.CFrame; return end
    local _,lp,_=lastCF:ToEulerAnglesYXZ()
    local _,cp,_=Camera.CFrame:ToEulerAnglesYXZ()
    if cp-lp<-0.003 then Camera.CFrame=lastCF else lastCF=Camera.CFrame end
end

local function RunMisc()
    local now=tick(); if now-MT<MR then return end; MT=now
    local char=LocalPlayer.Character; if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum and S.misc_speed then hum.WalkSpeed=S.misc_speed_val end
    if S.misc_inf_ammo then
        local tool=char:FindFirstChildOfClass("Tool")
        if tool then
            for _,v in ipairs(tool:GetDescendants()) do
                if v:IsA("NumberValue") then
                    local n=v.Name:lower()
                    if n:find("ammo") or n:find("mag") or n:find("bullet") then v.Value=9999 end
                end
            end
        end
    end
end

local function ApplyTool(tool)
    if not tool then return end
    for _,v in ipairs(tool:GetDescendants()) do
        if v:IsA("NumberValue") then
            local n=v.Name:lower()
            if S.mod_attack_speed and (n:find("cooldown") or n:find("firerate") or n:find("delay")) then
                v.Value=v.Value*(100/math.max(S.mod_attack_pct,1))
            end
            if S.mod_fast_reload and n:find("reload") then
                v.Value=v.Value*(100/math.max(S.mod_reload_pct,1))
            end
            if S.mod_fast_ads and (n:find("ads") or n:find("aimtime")) then
                v.Value=v.Value*(100/math.max(S.mod_ads_pct,1))
            end
        end
    end
end
LocalPlayer.CharacterAdded:Connect(function(char)
    char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") then task.wait(0.05); ApplyTool(c) end
    end)
end)

