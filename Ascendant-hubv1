-- ============================================================
--  [5] UTILITY
-- ============================================================
local KATANAS  = {"Katana","Sword","Blade"}
local SHIELDS  = {"RiotShield","Shield"}
local BONES    = {"Head","UpperTorso","LowerTorso","HumanoidRootPart"}
local THROWNS  = {"Grenade","FlashGrenade","SmokeGrenade","Molotov","Throwable","Bomb"}

local function W2S(p)
    local s,on=Camera:WorldToViewportPoint(p)
    if on then return Vector2.new(s.X,s.Y),true end
    return nil,false
end
local function D3(a,b) return (a-b).Magnitude end
local function GCP(pl)
    local c=pl.Character; if not c then return nil,nil,nil end
    return c:FindFirstChild("HumanoidRootPart"),c:FindFirstChildOfClass("Humanoid"),c:FindFirstChild("Head")
end
local function FRay(o,d) return workspace:Raycast(o,d,RayP) end
local function Vis(a,b) return FRay(a,b-a)==nil end
local function WBang(a,b)
    local h=FRay(a,b-a); if not h then return true end
    local off=(b-a).Unit*(h.Distance+0.6)
    return FRay(a+off,b-(a+off))==nil
end
local function StateCol(lr,tp)
    if Vis(lr.Position,tp) then return S.esp_col_visible end
    if WBang(lr.Position,tp) then return S.esp_col_wallbang end
    return S.esp_col_hidden
end
local function GetBB(char)
    local r=char:FindFirstChild("HumanoidRootPart"); if not r then return nil end
    local top,ot=W2S(r.Position+Vector3.new(0,3.2,0))
    local bot,ob=W2S(r.Position-Vector3.new(0,2.3,0))
    if not ot or not ob then return nil end
    local h=math.abs(top.Y-bot.Y); local w=h*0.45
    return {x=top.X-w/2,y=top.Y,w=w,h=h,mx=top.X,ty=top.Y,by=bot.Y}
end
local function GWep(char)
    local t=char:FindFirstChildOfClass("Tool"); return t and t.Name or "None"
end
local function HasItem(char,list)
    local w=GWep(char):lower()
    for _,n in ipairs(list) do if w:find(n:lower()) then return true end end
    return false
end
local function ArrowPos(sp)
    local c=Vector2.new(VP().X/2,VP().Y/2)
    local d=sp-c; if d.Magnitude==0 then return nil,nil end
    local n=d.Unit; return c+n*100,math.atan2(n.Y,n.X)
end

