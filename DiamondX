end

local function hideEsp(player)
    if espCache[player] then
        for _, obj in pairs(espCache[player]) do obj.Visible = false end
    end
end

local function removeEsp(player)
    if espCache[player] then
        for _, obj in pairs(espCache[player]) do obj:Remove() end
        espCache[player] = nil
    end
end

--// utils
local function isAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(plr)
    if not Enabled.TeamCheck then return false end
    return plr.Team == LocalPlayer.Team
end

local function isVisible(part)
    if not Enabled.WallCheck then return true end
    if not part then return false end
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    local result = Workspace:Raycast(origin, dir, params)
    if result then
        return result.Instance:IsDescendantOf(part.Parent)
    end
    return true
end

local function getClosest()
    local closest = nil
    local shortest = Enabled.FOV
    local mousePos = UIS:GetMouseLocation()
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not isAlive(plr) then continue end
        if isTeammate(plr) then continue end
        
        local char = plr.Character
        local aimPart = char and char:FindFirstChild(Enabled.AimPart)
        if not aimPart then continue end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local dist = hrp and (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude or 0
        if dist > Enabled.MaxDist then continue end
        
        if not isVisible(aimPart) then continue end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
        if not onScreen then continue end
        
        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if screenDist < shortest then
            shortest = screenDist
            closest = aimPart
        end
    end
    
    return closest
end

local target = nil

--// silent aim hook
local mt = getrawmetatable and getrawmetatable(game)
if mt then
    local old = mt.__namecall
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if Enabled.Silent and target and method == "FireServer" then
            if #args >= 2 and typeof(args[2]) == "Vector3" then
                if typeof(args[1]) == "Vector3" then
                    args[2] = (target.Position - args[1]).Unit
                end
            elseif #args >= 3 and typeof(args[3]) == "Vector3" then
                if typeof(args[2]) == "Vector3" then
                    args[3] = (target.Position - args[2]).Unit
                end
            elseif #args >= 1 and typeof(args[1]) == "CFrame" then
                args[1] = CFrame.new(args[1].Position, target.Position)
            end
        end
        
        return old(self, unpack(args))
    end)
    
    setreadonly(mt, true)
end

--// weapon mods
local originals = {}

local function storeOriginal(tool, obj)
    if not originals[tool] then originals[tool] = {} end
    if originals[tool][obj] == nil then
        originals[tool][obj] = obj.Value
    end
end

local function applyMods()
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Tool") then
            local cfg = obj:FindFirstChild("Configuration") or obj:FindFirstChild("Config") or obj:FindFirstChild("Settings")
            if cfg then
                for _, val in ipairs(cfg:GetDescendants()) do
                    if val:IsA("NumberValue") or val:IsA("IntValue") then
                        local name = val.Name:lower()
                        storeOriginal(obj, val)
                        
                        -- no recoil
                        if name:find("recoil") then
                            val.Value = Enabled.NoRecoil and 0 or originals[obj][val]
                        end
                        
                        -- no spread
                        if name:find("spread") then
                            val.Value = Enabled.NoSpread and 0 or originals[obj][val]
                        end
                        
                        -- rapid fire 0.05s
                        if Enabled.RapidFire then
                            if name:find("firerate") or name:find("firespeed") or name:find("rpm") then
                                val.Value = 20
                            elseif name:find("cooldown") or name:find("delay") or name:find("reload") or
                                   name:find("shotdelay") or name:find("shootdelay") or name:find("timedelay") then
                                val.Value = 0.05
                            end
                        else
                            if (name:find("firerate") or name:find("firespeed") or name:find("rpm") or
                                name:find("cooldown") or name:find("delay") or name:find("reload") or
                                name:find("shotdelay") or name:find("shootdelay") or name:find("timedelay")) and
                                originals[obj][val] ~= nil then
                                val.Value = originals[obj][val]
                            end
                        end
                    end
                end
            end
        end
    end
end

--// fly / noclip
local flyConn = nil
local noclipConn = nil

local function startFly()
    if flyConn then flyConn:Disconnect() end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    
    flyConn = RunService.RenderStepped:Connect(function()
        if not Enabled.Fly then
            bv:Destroy()
            flyConn:Disconnect()
            flyConn = nil
            return
        end
        local cf = Camera.CFrame
        local move = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0, 1, 0) end
        if move.Magnitude > 0 then move = move.Unit * Enabled.FlySpeed end
        bv.Velocity = move
    end)
end

local function startNoclip()
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = RunService.Stepped:Connect(function()
        if not Enabled.Noclip then
            noclipConn:Disconnect()
            noclipConn = nil
            return
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

--// inf jump
UIS.JumpRequest:Connect(function()
    if Enabled.InfJump then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

--// main loop
RunService.RenderStepped:Connect(function()
    -- get target
    if Enabled.Aimbot or Enabled.Silent or Enabled.Orbit then
        target = getClosest()
    else
        target = nil
    end
    
    -- fov circle
    fovCircle.Position = UIS:GetMouseLocation()
    fovCircle.Radius = Enabled.FOV
    fovCircle.Visible = Enabled.Aimbot or Enabled.Silent
    
    -- orbit / aimbot
    if Enabled.Orbit and target then
        if Enabled.OrbitRadius > 0 then
            local pos = target.Position
            local angle = tick() * Enabled.OrbitSpeed
            local offset = Vector3.new(
                math.cos(angle) * Enabled.OrbitRadius,
                Enabled.OrbitHeight,
                math.sin(angle) * Enabled.OrbitRadius
            )
            Camera.CFrame = CFrame.new(pos + offset, pos)
        else
            -- radius 0 = just aim, no orbit cam
            local sp = Camera:WorldToViewportPoint(target.Position)
            local mp = UIS:GetMouseLocation()
            local vec = Vector2.new(sp.X - mp.X, sp.Y - mp.Y)
            local s = math.clamp(Enabled.Smooth, 0.01, 0.5)
            mousemoverel(vec.X * s, vec.Y * s)
        end
    elseif Enabled.Aimbot and target and not Enabled.Orbit then
        local sp = Camera:WorldToViewportPoint(target.Position)
        local mp = UIS:GetMouseLocation()
        local vec = Vector2.new(sp.X - mp.X, sp.Y - mp.Y)
        local s = math.clamp(Enabled.Smooth, 0.01, 0.5)
        mousemoverel(vec.X * s, vec.Y * s)
    end
    
    -- triggerbot
    if Enabled.Trigger and target then
        local sp = Camera:WorldToViewportPoint(target.Position)
        local mp = UIS:GetMouseLocation()
        if (Vector2.new(sp.X, sp.Y) - mp).Magnitude < 15 then
            mouse1click()
        end
    end
    
    -- weapon mods
    if Enabled.NoRecoil or Enabled.NoSpread or Enabled.RapidFire then
        applyMods()
    end
    
    -- fly
    if Enabled.Fly and not flyConn then
        startFly()
    end
    
    -- noclip
    if Enabled.Noclip and not noclipConn then
        startNoclip()
    end
    
    -- esp
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then
            hideEsp(plr)
            continue
        end
        
        if not Enabled.ESP then
            hideEsp(plr)
            continue
        end
        
        if not isAlive(plr) then
            hideEsp(plr)
            continue
        end
        
        if isTeammate(plr) then
            hideEsp(plr)
            continue
        end
        
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if not hrp or not head or not hum then
            hideEsp(plr)
            continue
        end
        
        local e = getEsp(plr)
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        
        if not onScreen then
            hideEsp(plr)
            continue
        end
        
        local h = math.abs(headPos.Y - legPos.Y)
        local w = h * 0.55
        
        if Enabled.ESPBox then
            e.box.Size = Vector2.new(w, h)
            e.box.Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
            e.box.Visible = true
            e.outline.Size = e.box.Size
            e.outline.Position = e.box.Position
            e.outline.Visible = true
        else
            e.box.Visible = false
            e.outline.Visible = false
        end
        
        if Enabled.ESPName then
            e.name.Text = plr.Name
            e.name.Position = Vector2.new(pos.X, headPos.Y - 18)
            e.name.Visible = true
        else
            e.name.Visible = false
        end
        
        if Enabled.ESPHealth then
            local hp = math.floor(hum.Health)
            local maxHp = math.floor(hum.MaxHealth)
            e.health.Text = hp .. "/" .. maxHp
            e.health.Position = Vector2.new(pos.X, legPos.Y + 4)
            e.health.Color = Color3.fromRGB(255 - (hp/maxHp)*255, (hp/maxHp)*255, 0)
            e.health.Visible = true
        else
            e.health.Visible = false
        end
        
        if Enabled.ESPDist then
            local d = math.floor((hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
            e.dist.Text = d .. "m"
            e.dist.Position = Vector2.new(pos.X, legPos.Y + (Enabled.ESPHealth and 16 or 4))
            e.dist.Visible = true
        else
            e.dist.Visible = false
        end
        
        if Enabled.ESPTracer then
            e.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            e.tracer.To = Vector2.new(pos.X, legPos.Y)
            e.tracer.Visible = true
        else
            e.tracer.Visible = false
        end
    end
end)

