local TOPBAR     = Color3.fromRGB(14,  16,  30)
local PANEL_BG   = Color3.fromRGB( 9,  10,  20)
local BORDER     = Color3.fromRGB(70,  50, 110)
local ACCENT     = Color3.fromRGB(100, 60, 190)
local WHITE      = Color3.fromRGB(255,255,255)
local TEXT       = Color3.fromRGB(220,215,235)
local TEXT_DIM   = Color3.fromRGB(150,140,175)
local CB_OFF     = Color3.fromRGB( 18, 14,  32)
local SLIDER_F   = Color3.fromRGB( 85, 50, 160)
local BTN_BG     = Color3.fromRGB( 18, 16,  34)
local INPUT_BG   = Color3.fromRGB( 10,  9,  20)
local FONT       = Enum.Font.Code
local TS         = 13

