-- Live FPS / ping ticker
local fCount, fLast, fps = 0, tick(), 60
RunService.RenderStepped:Connect(function()
    fCount += 1
    local now = tick()
    if now - fLast >= 1 then
        fps    = math.floor(fCount / (now - fLast))
        fCount = 0
        fLast  = now
    end
    local ping = 0
    pcall(function()
        ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
    WMText.Text = string.format(
        "Nesix Hub | V1.0 (Beta) | Free | %d fps | %d ms", fps, ping)
end)

