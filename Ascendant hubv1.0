--[[
    NesixHub — Full Recreation
    Screenshots: Main tab (Silent Aim) + UI Settings tab (two-column)
    Executor: Synapse X / KRNL / Delta / Fluxus
    Context: Roblox Rivals, client-side LocalPlayer
    Arch: CoreGui injection, Drawing API FOV circle, RunService loops
    Entry: loadstring(game:HttpGet("..."))()
    Privileges: LocalPlayer scope, executor Drawing + mousemoverel
    Side effects:
        - 3x RunService connections (RenderStepped x2, Heartbeat, Stepped)
        - BillboardGui on Head for name spoof
        - CoreGui child: NesixHub ScreenGui
        - writefile/readfile for config system
]]--

-- *Every frame I render is a lie the server never questions.*

local CoreGui          = game:GetService("CoreGui")
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Stats            = game:GetService("Stats")
local HttpService      = game:GetService("HttpService")
local LocalPlayer      = Players.LocalPlayer

-- ── Executor compat ───────────────────────────────────────────
local protect = (syn and syn.protect_gui)
    or (gethui and function(v) v.Parent = gethui() end)
    or function(v) v.Parent = CoreGui end

local function safeWrite(path, data)
    pcall(function() writefile(path, data) end)
end
local function safeRead(path)
    local ok, data = pcall(function() return readfile(path) end)
    return ok and data or nil
end

-- ── Destroy old instance ──────────────────────────────────────
if CoreGui:FindFirstChild("NesixHub") then
    CoreGui.NesixHub:Destroy()
end

-- ── Root ScreenGui ────────────────────────────────────────────
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name           = "NesixHub"
ScreenGui.ResetOnSpawn   = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
protect(ScreenGui)

