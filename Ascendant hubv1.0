espBox.Size = UDim2.new(0, 295, 0, 240)
espBox.Position = UDim2.new(0, 8, 0, 8)
espBox.BackgroundColor3 = Color3.fromRGB(14, 11, 19)
espBox.BorderColor3 = Color3.fromRGB(60, 45, 80)
espBox.BorderSizePixel = 1
espBox.Parent = espPage

local espTitle = Instance.new("TextLabel")
espTitle.Size = UDim2.new(1, 0, 0, 18)
espTitle.Position = UDim2.new(0, 6, 0, 4)
espTitle.BackgroundTransparency = 1
espTitle.Font = Enum.Font.Code
espTitle.Text = "esp & visual enhancements   ..."
espTitle.TextColor3 = Color3.fromRGB(150, 130, 170)
espTitle.TextSize = 11
espTitle.TextXAlignment = Enum.TextXAlignment.Left
espTitle.Parent = espBox

createCheckbox(espBox, "health esp", false, UDim2.new(0, 0, 0, 30), function(state) EspHealthEnabled = state end)
createCheckbox(espBox, "distance esp", false, UDim2.new(0, 0, 0, 60), function(state) EspDistanceEnabled = state end)
createCheckbox(espBox, "bullet tracers", false, UDim2.new(0, 0, 0, 90), function(state) BulletTracersEnabled = state end)
createCheckbox(espBox, "crosshair fov circle", false, UDim2.new(0, 0, 0, 120), function(state) CrosshairFovEnabled = state end)
createFingerSlider(espBox, "fov radius size", 30, 400, FovRadius, 160, function(val) FovRadius = val end)

-- Visuals Tab (Name Spoofer Addition)
local visualsPage = tabPages["visuals"]
local nameSpoofBox = Instance.new("Frame")
nameSpoofBox.Size = UDim2.new(0, 295, 0, 150)
nameSpoofBox.Position = UDim2.new(0, 8, 0, 8)
nameSpoofBox.BackgroundColor3 = Color3.fromRGB(14, 11, 19)
nameSpoofBox.BorderColor3 = Color3.fromRGB(60, 45, 80)
nameSpoofBox.BorderSizePixel = 1
nameSpoofBox.Parent = visualsPage

local nameSpoofTitle = Instance.new("TextLabel")
nameSpoofTitle.Size = UDim2.new(1, 0, 0, 18)
nameSpoofTitle.Position = UDim2.new(0, 6, 0, 4)
nameSpoofTitle.BackgroundTransparency = 1
nameSpoofTitle.Font = Enum.Font.Code
nameSpoofTitle.Text = "client name spoofer          ..."
nameSpoofTitle.TextColor3 = Color3.fromRGB(150, 130, 170)
nameSpoofTitle.TextSize = 11
nameSpoofTitle.TextXAlignment = Enum.TextXAlignment.Left
nameSpoofTitle.Parent = nameSpoofBox

createCheckbox(nameSpoofBox, "enable name spoofer", false, UDim2.new(0, 0, 0, 30), function(state)
    NameSpoofEnabled = state
end)

local nameInputBox = Instance.new("TextBox")
nameInputBox.Size = UDim2.new(1, -20, 0, 30)
nameInputBox.Position = UDim2.new(0, 10, 0, 65)
nameInputBox.BackgroundColor3 = Color3.fromRGB(20, 16, 28)
nameInputBox.BorderColor3 = Color3.fromRGB(60, 45, 80)
nameInputBox.Font = Enum.Font.Code
nameInputBox.Text = SpoofedNameText
nameInputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
nameInputBox.TextSize = 12
nameInputBox.ClearTextOnFocus = false
nameInputBox.Parent = nameSpoofBox

nameInputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SpoofedNameText = nameInputBox.Text
    end
end)

