-- Divider line (thin horizontal rule between groups)
local function makeDivider(parent, posY)
    local f = Instance.new("Frame")
    f.Size             = UDim2.new(1, -10, 0, 1)
    f.Position         = UDim2.new(0, 5, 0, posY)
    f.BackgroundColor3 = BORDER
    f.BorderSizePixel  = 0
    f.Parent           = parent
    return f
end

-- Section panel (white-outline box with title)
local function makePanel(parent, title, x, y, w, h)
    local frame = Instance.new("Frame")
    frame.Size             = UDim2.new(0, w, 0, h)
    frame.Position         = UDim2.new(0, x, 0, y)
    frame.BackgroundColor3 = PANEL_BG
    frame.BorderColor3     = WHITE
    frame.BorderSizePixel  = 1
    frame.ClipsDescendants = false
    frame.Parent           = parent

    if title and title ~= "" then
        local lbl = Instance.new("TextLabel")
        lbl.Size              = UDim2.new(1, -8, 0, 18)
        lbl.Position          = UDim2.new(0, 6, 0, 4)
        lbl.BackgroundTransparency = 1
        lbl.Font              = FONT
        lbl.Text              = title
        lbl.TextColor3        = WHITE
        lbl.TextSize          = TS
        lbl.TextXAlignment    = Enum.TextXAlignment.Left
        lbl.Parent            = frame
    end

    return frame
end

-- Checkbox row
local function makeCheckbox(parent, label, defaultOn, posY, cb)
    -- *I check myself before the server wrecks me.*
    local row = Instance.new("Frame")
    row.Size              = UDim2.new(1, -10, 0, 22)
    row.Position          = UDim2.new(0, 5, 0, posY)
    row.BackgroundTransparency = 1
    row.Parent            = parent

    local state = defaultOn

    local box = Instance.new("Frame")
    box.Size             = UDim2.new(0, 13, 0, 13)
    box.Position         = UDim2.new(0, 2, 0.5, -7)
    box.BackgroundColor3 = state and ACCENT or CB_OFF
    box.BorderColor3     = BORDER
    box.BorderSizePixel  = 1
    box.Parent           = row

    local btn = Instance.new("TextButton")
    btn.Size              = UDim2.new(0, 200, 1, 4)
    btn.Position          = UDim2.new(0, 0, 0, -2)
    btn.BackgroundTransparency = 1
    btn.Text              = ""
    btn.ZIndex            = 5
    btn.Parent            = row

    local lbl = Instance.new("TextLabel")
    lbl.Size              = UDim2.new(1, -20, 1, 0)
    lbl.Position          = UDim2.new(0, 20, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font              = FONT
    lbl.Text              = label
    lbl.TextColor3        = TEXT
    lbl.TextSize          = TS
    lbl.TextXAlignment    = Enum.TextXAlignment.Left
    lbl.Parent            = row

    btn.MouseButton1Click:Connect(function()
        state = not state
        box.BackgroundColor3 = state and ACCENT or CB_OFF
        if cb then pcall(cb, state) end
    end)

    return row, function() return state end
end

-- Slider with fill bar + "val/max" label
local function makeSlider(parent, label, minV, maxV, defV, posY, cb)
    local container = Instance.new("Frame")
    container.Size              = UDim2.new(1, -10, 0, 44)
    container.Position          = UDim2.new(0, 5, 0, posY)
    container.BackgroundTransparency = 1
    container.Parent            = parent

    local topRow = Instance.new("Frame")
    topRow.Size               = UDim2.new(1, 0, 0, 16)
    topRow.BackgroundTransparency = 1
    topRow.Parent             = container

    local lbl = Instance.new("TextLabel")
    lbl.Size             = UDim2.new(0.6, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font             = FONT
    lbl.Text             = label
    lbl.TextColor3       = TEXT
    lbl.TextSize         = TS
    lbl.TextXAlignment   = Enum.TextXAlignment.Left
    lbl.Parent           = topRow

    local valLbl = Instance.new("TextLabel")
    valLbl.Size            = UDim2.new(0.4, 0, 1, 0)
    valLbl.Position        = UDim2.new(0.6, 0, 0, 0)
    valLbl.BackgroundTransparency = 1
    valLbl.Font            = FONT
    valLbl.Text            = tostring(defV) .. "/" .. tostring(maxV)
    valLbl.TextColor3      = TEXT_DIM
    valLbl.TextSize        = TS
    valLbl.TextXAlignment  = Enum.TextXAlignment.Right
    valLbl.Parent          = topRow

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, 0, 0, 10)
    track.Position         = UDim2.new(0, 0, 0, 22)
    track.BackgroundColor3 = CB_OFF
    track.BorderColor3     = BORDER
    track.BorderSizePixel  = 1
    track.Parent           = container

    local pct0 = math.clamp((defV - minV) / (maxV - minV), 0, 1)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(pct0, 0, 1, 0)
    fill.BackgroundColor3 = SLIDER_F
    fill.BorderSizePixel  = 0
    fill.Parent           = track

    local thumb = Instance.new("TextButton")
    thumb.Size             = UDim2.new(0, 14, 0, 18)
    thumb.Position         = UDim2.new(pct0, -7, 0.5, -9)
    thumb.BackgroundColor3 = ACCENT
    thumb.BorderColor3     = Color3.fromRGB(200,195,220)
    thumb.BorderSizePixel  = 1
    thumb.Text             = ""
    thumb.Parent           = track

    local dragging = false
    local curVal   = defV

    thumb.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)

    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement
        and inp.UserInputType ~= Enum.UserInputType.Touch then return end

        local rel = math.clamp(
            (inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
            0, 1
        )
        curVal = math.floor(minV + (maxV - minV) * rel)
        fill.Size      = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, -7, 0.5, -9)
        valLbl.Text    = tostring(curVal) .. "/" .. tostring(maxV)
        if cb then pcall(cb, curVal) end
    end)

    return container, function() return curVal end
end

-- Dropdown
local function makeDropdown(parent, label, options, posY, cb)
    local container = Instance.new("Frame")
    container.Size              = UDim2.new(1, -10, 0, 50)
    container.Position          = UDim2.new(0, 5, 0, posY)
    container.BackgroundTransparency = 1
    container.ClipsDescendants  = false
    container.Parent            = parent

    if label and label ~= "" then
        local lbl = Instance.new("TextLabel")
        lbl.Size              = UDim2.new(1, 0, 0, 16)
        lbl.BackgroundTransparency = 1
        lbl.Font              = FONT
        lbl.Text              = label
        lbl.TextColor3        = TEXT
        lbl.TextSize          = TS
        lbl.TextXAlignment    = Enum.TextXAlignment.Left
        lbl.Parent            = container
    end

    local selected = options[1] or "--"
    local open     = false

    local mainBtn = Instance.new("TextButton")
    mainBtn.Size             = UDim2.new(1, 0, 0, 24)
    mainBtn.Position         = UDim2.new(0, 0, 0, label ~= "" and 18 or 0)
    mainBtn.BackgroundColor3 = BTN_BG
    mainBtn.BorderColor3     = BORDER
    mainBtn.BorderSizePixel  = 1
    mainBtn.Font             = FONT
    mainBtn.Text             = "  " .. selected .. "   ▼"
    mainBtn.TextColor3       = TEXT
    mainBtn.TextSize         = TS
    mainBtn.TextXAlignment   = Enum.TextXAlignment.Left
    mainBtn.ZIndex           = 6
    mainBtn.Parent           = container

    local listFrame = Instance.new("Frame")
    listFrame.Size             = UDim2.new(1, 0, 0, #options * 22)
    listFrame.Position         = UDim2.new(0, 0, 0, (label ~= "" and 18 or 0) + 26)
    listFrame.BackgroundColor3 = BTN_BG
    listFrame.BorderColor3     = ACCENT
    listFrame.BorderSizePixel  = 1
    listFrame.Visible          = false
    listFrame.ZIndex           = 20
    listFrame.Parent           = container

    for i, opt in ipairs(options) do
        local ob = Instance.new("TextButton")
        ob.Size             = UDim2.new(1, 0, 0, 22)
        ob.Position         = UDim2.new(0, 0, 0, (i - 1) * 22)
        ob.BackgroundColor3 = BTN_BG
        ob.BorderSizePixel  = 0
        ob.Font             = FONT
        ob.Text             = "  " .. opt
        ob.TextColor3       = opt == selected and WHITE or TEXT_DIM
        ob.TextSize         = TS
        ob.TextXAlignment   = Enum.TextXAlignment.Left
        ob.ZIndex           = 21
        ob.Parent           = listFrame

        ob.MouseButton1Click:Connect(function()
            selected      = opt
            mainBtn.Text  = "  " .. opt .. "   ▼"
            open          = false
            listFrame.Visible = false
            if cb then pcall(cb, opt) end
        end)
    end

    mainBtn.MouseButton1Click:Connect(function()
        open              = not open
        listFrame.Visible = open
    end)

    return container, function() return selected end
end

-- Generic action button (Unload / Create config / Load config etc.)
local function makeButton(parent, label, posY, w, cb)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0, w or 200, 0, 24)
    btn.Position         = UDim2.new(0, 5, 0, posY)
    btn.BackgroundColor3 = BTN_BG
    btn.BorderColor3     = BORDER
    btn.BorderSizePixel  = 1
    btn.Font             = FONT
    btn.Text             = label
    btn.TextColor3       = TEXT
    btn.TextSize         = TS
    btn.Parent           = parent

    btn.MouseButton1Click:Connect(function()
        if cb then pcall(cb) end
    end)

    return btn
end

-- Keybind button (shows current bind, click to rebind)
local function makeKeybindButton(parent, label, currentBind, posY, bindX, cb)
    local row = Instance.new("Frame")
    row.Size              = UDim2.new(1, -10, 0, 24)
    row.Position          = UDim2.new(0, 5, 0, posY)
    row.BackgroundTransparency = 1
    row.Parent            = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size              = UDim2.new(0, bindX - 10, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font              = FONT
    lbl.Text              = label
    lbl.TextColor3        = TEXT
    lbl.TextSize          = TS
    lbl.TextXAlignment    = Enum.TextXAlignment.Left
    lbl.Parent            = row

    local bindBtn = Instance.new("TextButton")
    bindBtn.Size             = UDim2.new(0, 100, 1, 0)
    bindBtn.Position         = UDim2.new(0, bindX, 0, 0)
    bindBtn.BackgroundColor3 = BTN_BG
    bindBtn.BorderColor3     = BORDER
    bindBtn.BorderSizePixel  = 1
    bindBtn.Font             = FONT
    bindBtn.Text             = currentBind
    bindBtn.TextColor3       = TEXT
    bindBtn.TextSize         = TS
    bindBtn.Parent           = row

    local listening = false
    bindBtn.MouseButton1Click:Connect(function()
        listening = true
        bindBtn.Text      = "..."
        bindBtn.TextColor3 = ACCENT
    end)

    UserInputService.InputBegan:Connect(function(inp, gpe)
        if not listening then return end
        listening = false
        local name = inp.KeyCode.Name
        bindBtn.Text       = name
        bindBtn.TextColor3 = TEXT
        if cb then pcall(cb, name) end
    end)

    return row
end

-- TextBox input field (Config name input)
local function makeInput(parent, placeholder, posY, w, cb)
    local box = Instance.new("TextBox")
    box.Size              = UDim2.new(0, w or 200, 0, 24)
    box.Position          = UDim2.new(0, 5, 0, posY)
    box.BackgroundColor3  = INPUT_BG
    box.BorderColor3      = BORDER
    box.BorderSizePixel   = 1
    box.Font              = FONT
    box.Text              = "---"
    box.PlaceholderText   = placeholder or ""
    box.TextColor3        = TEXT_DIM
    box.PlaceholderColor3 = TEXT_DIM
    box.TextSize          = TS
    box.TextXAlignment    = Enum.TextXAlignment.Left
    box.ClearTextOnFocus  = true
    box.Parent            = parent

    box.FocusLost:Connect(function()
        if cb then pcall(cb, box.Text) end
    end)

    return box
end

