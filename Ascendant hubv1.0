-- ── RIGHT: Configuration panel ───────────────────────────────
-- *Configuration: the illusion that settings persist across the void.*
local configPanel = makePanel(uiPage, "Configuration", 476, 6, 464, 400)

local configNameLabel = Instance.new("TextLabel")
configNameLabel.Size              = UDim2.new(1, -10, 0, 16)
configNameLabel.Position          = UDim2.new(0, 5, 0, 26)
configNameLabel.BackgroundTransparency = 1
configNameLabel.Font              = FONT
configNameLabel.Text              = "Config name"
configNameLabel.TextColor3        = TEXT
configNameLabel.TextSize          = TS
configNameLabel.TextXAlignment    = Enum.TextXAlignment.Left
configNameLabel.Parent            = configPanel

local configInput = makeInput(configPanel, "Enter name...", 46, 446, function(v)
    State.ConfigName = v
end)
configInput.Size = UDim2.new(1, -10, 0, 24)

-- Create config
makeButton(configPanel, "Create config", 80, 446, function()
    if State.ConfigName == "" or State.ConfigName == "---" then return end
    local data = HttpService:JSONEncode(State)
    safeWrite("NesixHub_" .. State.ConfigName .. ".json", data)
    table.insert(State.ConfigList, State.ConfigName)
end):Size(UDim2.new(1, -10, 0, 26))

-- Config list label + dropdown
local configListLabel = Instance.new("TextLabel")
configListLabel.Size              = UDim2.new(1, -10, 0, 16)
configListLabel.Position          = UDim2.new(0, 5, 0, 116)
configListLabel.BackgroundTransparency = 1
configListLabel.Font              = FONT
configListLabel.Text              = "Config list"
configListLabel.TextColor3        = TEXT
configListLabel.TextSize          = TS
configListLabel.TextXAlignment    = Enum.TextXAlignment.Left
configListLabel.Parent            = configPanel

local configDropBtn = Instance.new("TextButton")
configDropBtn.Size             = UDim2.new(1, -10, 0, 26)
configDropBtn.Position         = UDim2.new(0, 5, 0, 136)
configDropBtn.BackgroundColor3 = BTN_BG
configDropBtn.BorderColor3     = BORDER
configDropBtn.BorderSizePixel  = 1
configDropBtn.Font             = FONT
configDropBtn.Text             = "  " .. State.ActiveConfig .. "   ▼"
configDropBtn.TextColor3       = TEXT
configDropBtn.TextSize         = TS
configDropBtn.TextXAlignment   = Enum.TextXAlignment.Left
configDropBtn.Parent           = configPanel

-- Action buttons — Load / Overwrite / Delete / Refresh
local actionY = 172
for _, label in ipairs({"Load config", "Overwrite config", "Delete config", "Refresh list"}) do
    local btn = makeButton(configPanel, label, actionY, 446, function()
        if label == "Refresh list" then
            -- re-scan configs
        elseif label == "Load config" and State.ActiveConfig ~= "--" then
            local raw = safeRead("NesixHub_" .. State.ActiveConfig .. ".json")
            if raw then
                pcall(function()
                    local loaded = HttpService:JSONDecode(raw)
                    for k, v in pairs(loaded) do
                        if State[k] ~= nil then State[k] = v end
                    end
                end)
            end
        elseif label == "Delete config" and State.ActiveConfig ~= "--" then
            pcall(function() delfile("NesixHub_" .. State.ActiveConfig .. ".json") end)
        elseif label == "Overwrite config" and State.ActiveConfig ~= "--" then
            local data = HttpService:JSONEncode(State)
            safeWrite("NesixHub_" .. State.ActiveConfig .. ".json", data)
        end
    end)
    btn.Size     = UDim2.new(1, -10, 0, 26)
    btn.Position = UDim2.new(0, 5, 0, actionY)
    actionY      = actionY + 32
end

-- ══════════════════════════════════════════════════════════════
-- FOV CIRCLE  (Drawing API)
-- ══════════════════════════════════════════════════════════════
local fovCircle
if Drawing then
    fovCircle           = Drawing.new("Circle")
    fovCircle.Visible   = false
    fovCircle.Filled    = false
    fovCircle.Thickness = 1
    fovCircle.Color     = Color3.fromRGB(255,255,255)
    fovCircle.NumSides  = 64
end

-- ══════════════════════════════════════════════════════════════
-- SILENT AIM RUNTIME
-- ══════════════════════════════════════════════════════════════
local camera = workspace.CurrentCamera

RunService.Heartbeat:Connect(function()
    pcall(function()
        camera = workspace.CurrentCamera
        local mousePt = UserInputService:GetMouseLocation()

        if fovCircle then
            fovCircle.Visible = State.ShowFov
            if State.ShowFov then
                fovCircle.Radius   = State.FovRadius
                fovCircle.Position = mousePt
            end
        end

        if not State.SilentAim then return end

        local best, bestD = nil, State.IgnoreFov and math.huge or State.FovRadius

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer or not plr.Character then continue end
            if State.TeamCheck and LocalPlayer.Team
            and plr.Team == LocalPlayer.Team then continue end

            local char = plr.Character
            local part = char:FindFirstChild(State.TargetPart)
                      or char:FindFirstChild("HumanoidRootPart")
            local hum  = char:FindFirstChildOfClass("Humanoid")

            if part and hum and hum.Health > 0 then
                local sp, vis = camera:WorldToViewportPoint(part.Position)
                if vis then
                    local d = (Vector2.new(sp.X, sp.Y) - mousePt).Magnitude
                    if d < bestD then bestD = d; best = plr end
                end
            end
        end

        if best and best.Character then
            local part = best.Character:FindFirstChild(State.TargetPart)
                      or best.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local sp = camera:WorldToViewportPoint(part.Position)
                -- *mousemoverel: the quietest shot you'll never hear.*
                mousemoverel(sp.X - mousePt.X, sp.Y - mousePt.Y)
            end
        end
    end)
end)

-- ══════════════════════════════════════════════════════════════
-- NOCLIP
-- ══════════════════════════════════════════════════════════════
RunService.Stepped:Connect(function()
    if not State.Noclip then return end
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end)

-- ══════════════════════════════════════════════════════════════
-- INF JUMP
-- ══════════════════════════════════════════════════════════════
UserInputService.JumpRequest:Connect(function()
    if not State.InfJump then return end
    pcall(function()
        local hum = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
end)

-- ══════════════════════════════════════════════════════════════
-- ORBIT
-- ══════════════════════════════════════════════════════════════
local orbitAngle = 0
RunService.RenderStepped:Connect(function(dt)
    if not State.OrbitEnemy then return end
    pcall(function()
        local char = LocalPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local target, bestD = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer or not plr.Character then continue end
            local tHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local d = (tHrp.Position - hrp.Position).Magnitude
                if d < bestD then bestD = d; target = tHrp end
            end
        end

        if target then
            orbitAngle = orbitAngle + State.OrbitSpeed * dt
            local r = State.OrbitRadius
            local x = target.Position.X + math.cos(math.rad(orbitAngle)) * r
            local z = target.Position.Z + math.sin(math.rad(orbitAngle)) * r
            hrp.CFrame = CFrame.new(x, target.Position.Y, z)
                       * CFrame.Angles(0, math.rad(orbitAngle + 90), 0)
        end
    end)
end)

-- ══════════════════════════════════════════════════════════════
-- NAME SPOOFER
-- ══════════════════════════════════════════════════════════════
local origName = LocalPlayer.Name
RunService.RenderStepped:Connect(function()
    if not State.NameSpoof then return end
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        if not head then return end

        local bb = head:FindFirstChild("NesixTag")
        if not bb then
            bb = Instance.new("BillboardGui")
            bb.Name        = "NesixTag"
            bb.Size        = UDim2.new(0, 100, 0, 40)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.Parent      = head
            local tl = Instance.new("TextLabel")
            tl.Name     = "L"
            tl.Size     = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.Font     = FONT
            tl.TextColor3 = WHITE
            tl.TextStrokeTransparency = 0.5
            tl.TextSize = 14
            tl.Parent   = bb
        end
        bb.Enabled = true
        local lbl = bb:FindFirstChild("L")
        if lbl then lbl.Text = State.SpoofName end

        for _, g in ipairs(CoreGui:GetDescendants()) do
            if (g:IsA("TextLabel") or g:IsA("TextBox")) then
                if string.find(g.Text, origName) then
                    g.Text = string.gsub(g.Text, origName, State.SpoofName)
                end
            end
        end
    end)
end)

