-- Tab strip
local TabStrip = Instance.new("Frame")
TabStrip.Size             = UDim2.new(1, -8, 0, 30)
TabStrip.Position         = UDim2.new(0, 4, 0, 34)
TabStrip.BackgroundTransparency = 1
TabStrip.Parent           = Main

