UIListLayout.FillDirection = Enum.FillDirection.Horizontal
UIListLayout.SortOrder     = Enum.SortOrder.LayoutOrder
UIListLayout.Padding       = UDim.new(0, 2)
UIListLayout.Parent        = TabStrip

local ContentHost = Instance.new("Frame")
ContentHost.Size             = UDim2.new(1, -8, 1, -72)
ContentHost.Position         = UDim2.new(0, 4, 0, 68)
ContentHost.BackgroundColor3 = BG
ContentHost.BorderColor3     = BORDER
ContentHost.BorderSizePixel  = 1
ContentHost.ClipsDescendants = true
ContentHost.Parent           = Main

local TABS     = {"Main", "ESP", "Visual", "Character", "Misc", "UI Settings"}
local tabBtns  = {}
local tabPages = {}

local function switchTab(name)
    for _, n in ipairs(TABS) do
        tabPages[n].Visible = (n == name)
        if n == name then
            tabBtns[n].BorderColor3 = ACCENT
            tabBtns[n].TextColor3   = WHITE
        else
            tabBtns[n].BorderColor3 = BORDER
            tabBtns[n].TextColor3   = TEXT_DIM
        end
    end
end

for i, name in ipairs(TABS) do
    local btn = Instance.new("TextButton")
    btn.Name             = name .. "Tab"
    btn.Size             = UDim2.new(0, 155, 1, 0)
    btn.BackgroundColor3 = TOPBAR
    btn.BorderColor3     = BORDER
    btn.BorderSizePixel  = 1
    btn.Font             = FONT
    btn.Text             = name
    btn.TextColor3       = TEXT_DIM
    btn.TextSize         = TS
    btn.LayoutOrder      = i
    btn.Parent           = TabStrip
    tabBtns[name] = btn

    local page = Instance.new("ScrollingFrame")
    page.Name                = name .. "Page"
    page.Size                = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel     = 0
    page.CanvasSize          = UDim2.new(0, 0, 0, 900)
    page.ScrollBarThickness  = 4
    page.ScrollBarImageColor3 = ACCENT
    page.Visible             = false
    page.Parent              = ContentHost
    tabPages[name] = page

    btn.MouseButton1Click:Connect(function() switchTab(name) end)
end

