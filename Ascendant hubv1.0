    Noclip       = false,
    InfJump      = false,
    SpeedHack    = false,
    WalkSpeed    = 16,
    JumpPower    = 50,

    -- Orbit
    OrbitEnemy   = false,
    OrbitRadius  = 15,
    OrbitSpeed   = 10,

    -- Misc
    NameSpoof    = false,
    SpoofName    = "NesixUser",
    AntiAFK      = false,
    Desync       = false,
    SpinSpeed    = 100,

    -- UI Settings
    ShowToggleBtn  = true,
