-- Misc Tab (Ragebot, Orbit, Spin Speed)
local miscPage = tabPages["misc"]
local rageBox = Instance.new("Frame")
rageBox.Size = UDim2.new(0, 295, 0, 330)
rageBox.Position = UDim2.new(0, 8, 0, 8)
rageBox.BackgroundColor3 = Color3.fromRGB(14, 11, 19)
rageBox.BorderColor3 = Color3.fromRGB(60, 45, 80)
rageBox.BorderSizePixel = 1
rageBox.Parent = miscPage

local rageTitle = Instance.new("TextLabel")
rageTitle.Size = UDim2.new(1, 0, 0, 18)
rageTitle.Position = UDim2.new(0, 6, 0, 4)
rageTitle.BackgroundTransparency = 1
rageTitle.Font = Enum.Font.Code
rageTitle.Text = "ragebot / orbit / desync      ..."
rageTitle.TextColor3 = Color3.fromRGB(150, 130, 170)
rageTitle.TextSize = 11
rageTitle.TextXAlignment = Enum.TextXAlignment.Left
rageTitle.Parent = rageBox

createCheckbox(rageBox, "orbit enabled", false, UDim2.new(0, 0, 0, 30), function(state) OrbitEnabled = state end)
createCheckbox(rageBox, "ragebot desync", false, UDim2.new(0, 0, 0, 55), function(state) DesyncEnabled = state end)
createCheckbox(rageBox, "toggle / untoggle gui", true, UDim2.new(0, 0, 0, 80), function(state)
    MainFrame.Visible = state
    isToggledOn = state
end)
createCheckbox(rageBox, "lock / unlock gui", false, UDim2.new(0, 0, 0, 105), function(state)
    MainFrame.Draggable = not state
end)

createFingerSlider(rageBox, "orbit radius", 5, 50, OrbitRadius, 135, function(val) OrbitRadius = val end)
createFingerSlider(rageBox, "orbit speed", 2, 30, OrbitSpeed, 185, function(val) OrbitSpeed = val end)
createFingerSlider(rageBox, "spin speed adj", 20, 500, SpinSpeed, 235, function(val) SpinSpeed = val end)

switchTab("main")
