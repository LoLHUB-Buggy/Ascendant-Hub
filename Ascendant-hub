UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.Insert then
        Main.Visible = not Main.Visible
    elseif inp.KeyCode == Enum.KeyCode.RightShift then
        State.aimbot_enabled = not State.aimbot_enabled
        print("[AscendantHub] Aimbot: " .. tostring(State.aimbot_enabled))
    elseif inp.KeyCode == Enum.KeyCode.RightControl then
        State.ragebot_enabled = not State.ragebot_enabled
        print("[AscendantHub] Ragebot: " .. tostring(State.ragebot_enabled))
    elseif inp.KeyCode == Enum.KeyCode.F8 then
        State.chat_spam = not State.chat_spam
        if State.chat_spam then startSpam() else stopSpam() end
        print("[AscendantHub] Chat Spam: " .. tostring(State.chat_spam))
    elseif inp.KeyCode == Enum.KeyCode.F9 then
        State.esp_enabled = not State.esp_enabled
        print("[AscendantHub] ESP: " .. tostring(State.esp_enabled))
    end
end)

