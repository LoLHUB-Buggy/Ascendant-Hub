-- Overrides the nametag BillboardGui that Roblox injects above character
local function applyFakeName()
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    for _, obj in ipairs(head:GetChildren()) do
        if obj:IsA("BillboardGui") then
            local nl = obj:FindFirstChildOfClass("TextLabel")
            if nl then
                nl.Text = State.fake_name and State.fake_name_text or LocalPlayer.Name
            end
        end
    end
end

