    lbl.Parent             = row

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, 0, 0, 14)
    track.Position         = UDim2.new(0, 0, 0, 20)
    track.BackgroundColor3 = THEME.SLIDER_BG
    track.BorderSizePixel  = 0
    track.Parent           = row
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 7)

    local fill = Instance.new("Frame")
    local pct  = (State[stateKey] - minVal) / (maxVal - minVal)
    fill.Size             = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = THEME.SLIDER_FILL
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 7)

    local dragging = false

    local function updateSlider(inputPos)
        local trackPos  = track.AbsolutePosition
        local trackSize = track.AbsoluteSize
        local rel = math.clamp((inputPos.X - trackPos.X) / trackSize.X, 0, 1)
        local val = math.floor(minVal + rel * (maxVal - minVal))
        State[stateKey]  = val
        fill.Size        = UDim2.new(rel, 0, 1, 0)
        lbl.Text         = label .. ": " .. tostring(val)
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(inp.Position)
        end
    end)
    track.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(inp.Position)
        end
    end)

    return row
end

-- TextBox row
local function makeTextbox(parent, label, stateKey, order, callback)
    local row = Instance.new("Frame")
    row.Size             = UDim2.new(1, 0, 0, 46)
    row.BackgroundTransparency = 1
    row.LayoutOrder      = order or 1
    row.Parent           = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size               = UDim2.new(1, 0, 0, 18)
    lbl.BackgroundTransparency = 1
    lbl.Text               = label
    lbl.TextColor3         = THEME.SUBTEXT
    lbl.TextSize           = 12
    lbl.Font               = Enum.Font.Gotham
    lbl.TextXAlignment     = Enum.TextXAlignment.Left
    lbl.Parent             = row

    local box = Instance.new("TextBox")
    box.Size             = UDim2.new(1, 0, 0, 26)
    box.Position         = UDim2.new(0, 0, 0, 20)
    box.BackgroundColor3 = THEME.SECTION
    box.BorderSizePixel  = 0
    box.Text             = State[stateKey]
    box.TextColor3       = THEME.TEXT
    box.TextSize         = 13
    box.Font             = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.Parent           = row
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)

    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 6)
    pad.Parent      = box

    box:GetPropertyChangedSignal("Text"):Connect(function()
        State[stateKey] = box.Text
        if callback then callback(box.Text) end
    end)

    return row
end

