-- ─── CHAT SPAM ───────────────────────────────────────────
local spamRunning = false
local lastSpam    = 0

local function sendChat(msg)
    pcall(function()
        -- Modern TextChatService path
        local tcs = game:GetService("TextChatService")
        if tcs and tcs.TextChannels then
            local ch = tcs.TextChannels:FindFirstChild("RBXGeneral")
            if ch then ch:SendAsync(msg) return end
        end
        -- Legacy chat remote fallback
        local remote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if remote then
            local sayMsg = remote:FindFirstChild("SayMessageRequest")
            if sayMsg then sayMsg:FireServer(msg, "All") return end
        end
    end)
end

local function startSpam()
    if spamRunning then return end
    spamRunning = true
    lastSpam = tick()
    coroutine.wrap(function()
        while spamRunning and State.chat_spam do
            if tick() - lastSpam >= State.spam_delay then
                sendChat(State.spam_message)
                lastSpam = tick()
            end
            task.wait(0.5)
        end
        spamRunning = false
    end)()
end

local function stopSpam()
    spamRunning = false
end

-- ─── AIMBOT SCAN ─────────────────────────────────────────
local function buildTargets()
    local targets = {}
    local localChar = LocalPlayer.Character
    if not localChar then return targets end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return targets end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hum or not hrp or not head then continue end
        if hum.Health <= 0 then continue end

        -- Team check (Rivals uses Teams service)
        if LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end

        local dist = (hrp.Position - localRoot.Position).Magnitude
        if dist > State.max_distance then continue end

        -- Visibility raycast
        local visible = false
        local rayOrigin = Camera.CFrame.Position
        local rayDir    = (head.Position - rayOrigin)
        local result = workspace:Raycast(rayOrigin, rayDir,
            RaycastParams.new())  -- simple; will hit terrain/parts before head if obstructed
        if result and result.Instance then
            local hit = result.Instance
            visible = hit:IsDescendantOf(char)
        end

        if State.targeting == "visible only" and not visible then continue end

        -- Screen position for FOV check
        local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude

        table.insert(targets, {
            Player     = player,
            Character  = char,
            Position   = head.Position,
            HRPPosition= hrp.Position,
            Distance   = dist,
            ScreenDist = screenDist,
            Visible    = visible,
            OnScreen   = onScreen,
        })
    end
    return targets
end

local function selectTarget(targets)
    local best = nil
    for _, t in ipairs(targets) do
        if t.ScreenDist > State.fov_radius then continue end
        if not best or t.ScreenDist < best.ScreenDist then
            best = t
        end
    end
    return best
end

-- Silent aim: redirect bullet origin toward target head
local currentTarget = nil

RunService.RenderStepped:Connect(function(dt)
    if not State.aimbot_enabled then
        currentTarget = nil
        return
    end
    if State.hit_chance < math.random(1, 100) then return end
    local targets = buildTargets()
    currentTarget = selectTarget(targets)
end)

-- ─── ESP ─────────────────────────────────────────────────
-- Draws highlight boxes via SelectionBox — lightweight, no drawing lib needed
local espObjects = {}

local function clearESP()
    for _, obj in pairs(espObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    espObjects = {}
end

local function updateESP()
    clearESP()
    if not State.esp_enabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local isTeam = LocalPlayer.Team and player.Team == LocalPlayer.Team
        local col = isTeam and State.esp_color_team or State.esp_color_enemy

        if State.esp_boxes then
            local box = Instance.new("SelectionBox")
            box.Color3         = col
            box.LineThickness  = 0.04
            box.SurfaceTransparency = 1
            box.Adornee        = char
            box.Parent         = workspace
            table.insert(espObjects, box)
        end

        if State.esp_names or State.esp_health then
            local bb = Instance.new("BillboardGui")
            bb.AlwaysOnTop  = true
            bb.Size         = UDim2.new(0, 100, 0, 40)
            bb.StudsOffset  = Vector3.new(0, 3, 0)
            bb.Adornee      = char:FindFirstChild("Head") or char.PrimaryPart
            bb.Parent       = workspace

            if State.esp_names then
                local nl = Instance.new("TextLabel")
                nl.Size                 = UDim2.new(1, 0, 0.5, 0)
                nl.BackgroundTransparency = 1
                nl.Text                 = player.Name
                nl.TextColor3           = col
                nl.TextScaled           = true
                nl.Font                 = Enum.Font.GothamBold
                nl.Parent               = bb
            end

            if State.esp_health then
                local hl = Instance.new("TextLabel")
                hl.Size                 = UDim2.new(1, 0, 0.5, 0)
                hl.Position             = UDim2.new(0, 0, 0.5, 0)
                hl.BackgroundTransparency = 1
                hl.Text                 = math.floor(hum.Health) .. " HP"
                hl.TextColor3           = Color3.fromRGB(100, 255, 100)
                hl.TextScaled           = true
                hl.Font                 = Enum.Font.Gotham
                hl.Parent               = bb
            end

            table.insert(espObjects, bb)
        end
    end
end

RunService.Heartbeat:Connect(function()
    updateESP()
end)

